{
  "contract": "Bridgey Protocol v1, native newline JSON transport, as spoken by Bridgey by Round Robin",
  "contractVersion": 1,
  "contractStatus": "draft for v0.10 (stabilisation), to be frozen at 1.0; last reviewed 2026-10-27",
  "upstreamBaseline": "singeol/bridgey 0.6.0-rc.2 (33a398c)",
  "statuses": {
    "upstream-v1": "Shipped by upstream Bridgey 0.5/0.6. Meaning, fields and limits change only through a new feature key, because upstream peers depend on them; frozen at 1.0.",
    "edition-extension": "An optional field the edition adds to an upstream-v1 message. Upstream peers ignore it.",
    "edition-draft": "Edition only, gated by a *_draft1 feature key. Sent only to peers that advertise the key. May change until accepted upstream, then moves to a final key.",
    "retired": "No longer sent or advertised. Receivers keep ignoring it; the key and its kinds are never reused.",
    "designed": "Specified in docs/protocol.md but not implemented by either client yet. Never sent."
  },
  "directions": {
    "phone-to-mac": "Android phone to Mac.",
    "mac-to-phone": "Mac to Android phone.",
    "either": "Both directions.",
    "sender-to-receiver": "From the side that sends a folder (the Mac today) to the side that receives it (the phone today).",
    "receiver-to-sender": "From the folder receiver (the phone today) to the folder sender (the Mac today).",
    "controller-to-host": "From the remote control controller (the phone) to the host (the Mac).",
    "host-to-controller": "From the remote control host (the Mac) to the controller (the phone)."
  },
  "transport": {
    "framing": "UTF-8 JSON object per line, terminated by LF; a CR before LF is ignored",
    "maxFrameBytes": 65536,
    "maxJsonDepth": 32,
    "onMalformedFrame": "close the session before dispatch (oversized frame, invalid UTF-8, not a JSON object, missing or wrong-typed envelope field)",
    "onUnknownKind": "ignore the message and keep the session",
    "onUndecryptablePayload": "upstream-v1 messages and folders/places close the session; clipboard offers, codes and remote input drop the message and keep the session",
    "replayWindow": "per session, the last 256 accepted messageId values, oldest evicted first",
    "port": 42458,
    "bonjour": "_bridgey._tcp"
  },
  "envelope": {
    "kind": { "type": "string", "required": true, "minBytes": 1, "maxBytes": 64 },
    "sessionId": { "type": "string", "required": true, "maxBytes": 128, "note": "empty only in pairing.cancel sent before the session ID is known" },
    "messageId": { "type": "string", "required": false, "note": "UUID; required by every encrypted message that uses the replay window. An empty optional string counts as absent" },
    "deviceId": { "type": "string", "required": false },
    "deviceName": { "type": "string", "required": false },
    "publicKey": { "type": "string", "required": false, "note": "base64 X9.63 P-256 ephemeral key" },
    "identityKey": { "type": "string", "required": false, "note": "base64 P-256 long-term signing key" },
    "proof": { "type": "string", "required": false },
    "signature": { "type": "string", "required": false },
    "nonce": { "type": "string", "required": false, "note": "base64 12-byte AES-GCM nonce" },
    "ciphertext": { "type": "string", "required": false, "note": "base64 AES-GCM ciphertext plus 16-byte tag" },
    "transferId": { "type": "string", "required": false },
    "sequence": { "type": "integer", "required": false, "min": -9007199254740991, "max": 9007199254740991, "note": "an integral JSON number; each kind checks its own range" },
    "targetDeviceId": { "type": "string", "required": false, "status": "edition-extension" }
  },
  "features": [
    { "key": "clipboard", "status": "upstream-v1", "requiredInMap": true, "missingMeans": "close (invalid feature state)" },
    { "key": "files", "status": "upstream-v1", "requiredInMap": true, "missingMeans": "close (invalid feature state)" },
    { "key": "notifications", "status": "upstream-v1", "requiredInMap": true, "missingMeans": "close (invalid feature state)" },
    { "key": "battery", "status": "upstream-v1", "requiredInMap": true, "missingMeans": "close (invalid feature state)" },
    { "key": "find_device", "status": "upstream-v1", "requiredInMap": true, "missingMeans": "close (invalid feature state)" },
    { "key": "ping", "status": "upstream-v1", "requiredInMap": false, "missingMeans": "false" },
    { "key": "links", "status": "upstream-v1", "requiredInMap": false, "missingMeans": "false" },
    { "key": "media", "status": "upstream-v1", "requiredInMap": false, "missingMeans": "false" },
    { "key": "calls", "status": "upstream-v1", "requiredInMap": false, "missingMeans": "false" },
    { "key": "clipboard_files_draft1", "status": "edition-draft", "requiredInMap": false, "missingMeans": "false" },
    { "key": "remote_input_draft1", "status": "edition-draft", "requiredInMap": false, "missingMeans": "false" },
    { "key": "sms_codes_draft1", "status": "edition-draft", "requiredInMap": false, "missingMeans": "false" },
    { "key": "folders_draft1", "status": "edition-draft", "requiredInMap": false, "missingMeans": "false" },
    { "key": "places_draft1", "status": "edition-draft", "requiredInMap": false, "missingMeans": "false" },
    { "key": "settings_sync_draft1", "status": "designed", "requiredInMap": false, "missingMeans": "false", "note": "never advertised yet" }
  ],
  "messages": [
    { "kind": "pairing.offer", "status": "upstream-v1", "direction": "either", "feature": null, "encrypted": false,
      "outer": ["sessionId", "deviceId", "deviceName", "publicKey", "targetDeviceId?"],
      "notes": "Sent by the side that dials. targetDeviceId (edition extension) names the trusted peer a reconnect is for; any other receiver closes quietly.",
      "implemented": ["android", "macos"] },
    { "kind": "pairing.answer", "status": "upstream-v1", "direction": "either", "feature": null, "encrypted": false,
      "outer": ["sessionId", "deviceId", "deviceName", "publicKey"],
      "implemented": ["android", "macos"] },
    { "kind": "pairing.confirm", "status": "upstream-v1", "direction": "either", "feature": null, "encrypted": false,
      "outer": ["sessionId", "deviceId", "identityKey", "proof", "signature"],
      "notes": "proof is an HMAC under the pairing key; signature is P-256 over the session transcript.",
      "implemented": ["android", "macos"] },
    { "kind": "pairing.cancel", "status": "upstream-v1", "direction": "either", "feature": null, "encrypted": false,
      "outer": ["sessionId"],
      "notes": "Ends only the session it arrives on.",
      "implemented": ["android", "macos"] },
    { "kind": "heartbeat.ping", "status": "upstream-v1", "direction": "either", "feature": null, "encrypted": false,
      "outer": ["sessionId", "messageId"], "reply": ["heartbeat.pong"],
      "implemented": ["android", "macos"] },
    { "kind": "heartbeat.pong", "status": "upstream-v1", "direction": "either", "feature": null, "encrypted": false,
      "outer": ["sessionId", "messageId"],
      "implemented": ["android", "macos"] },
    { "kind": "features.update", "status": "upstream-v1", "direction": "either", "feature": null, "encrypted": true, "replay": "messageId",
      "outer": ["sessionId", "messageId", "nonce", "ciphertext"],
      "payload": { "version": "integer, 1", "features": "object of feature key to boolean; see features" },
      "notes": "Sent after pairing and whenever local policy changes. A feature is available only when both peers report true.",
      "implemented": ["android", "macos"] },
    { "kind": "clipboard.update", "status": "upstream-v1", "direction": "either", "feature": "clipboard", "encrypted": true, "replay": "messageId", "maxPlaintextBytes": 32768,
      "outer": ["sessionId", "messageId", "nonce", "ciphertext"],
      "payload": { "(raw)": "UTF-8 text, not JSON, 1 to 32,768 bytes" },
      "reply": ["clipboard.ack", "clipboard.rejected"],
      "implemented": ["android", "macos"] },
    { "kind": "clipboard.rich", "status": "upstream-v1", "direction": "either", "feature": "clipboard", "encrypted": true, "replay": "messageId", "maxPlaintextBytes": 32768,
      "outer": ["sessionId", "messageId", "nonce", "ciphertext"],
      "payload": { "version": "integer, 1", "text": "string, required, not empty", "html": "string, optional" },
      "reply": ["clipboard.ack", "clipboard.rejected"],
      "notes": "text plus html at most 32 KiB.",
      "implemented": ["android", "macos"] },
    { "kind": "clipboard.ack", "status": "upstream-v1", "direction": "either", "feature": "clipboard", "encrypted": false,
      "outer": ["sessionId", "messageId"],
      "notes": "messageId is the acknowledged message's ID.",
      "implemented": ["android", "macos"] },
    { "kind": "clipboard.rejected", "status": "upstream-v1", "direction": "either", "feature": "clipboard", "encrypted": false,
      "outer": ["sessionId", "messageId"],
      "notes": "Clipboard is off locally; followed by features.update.",
      "implemented": ["android", "macos"] },
    { "kind": "clipboard.offer", "status": "edition-draft", "direction": "either", "feature": "clipboard_files_draft1", "encrypted": true, "replay": "messageId", "maxPlaintextBytes": 40960,
      "outer": ["sessionId", "messageId", "nonce", "ciphertext"],
      "payload": { "version": "integer, 1", "offerId": "string, UUID", "createdAt": "integer, Unix ms, >= 0", "sensitive": "boolean, optional",
        "items": "array of 1 to 100 {index, kind: text|html|image|file, mime (1 to 255 chars), name? (files, 1 to 255 chars), size (0 to 10 GiB), sha256? (base64 of 32 bytes), inline? (base64, all inline items at most 16 KiB decoded)}" },
      "reply": ["clipboard.ack", "clipboard.rejected"],
      "implemented": ["android", "macos"] },
    { "kind": "clipboard.fetch", "status": "edition-draft", "direction": "either", "feature": "clipboard_files_draft1", "encrypted": true, "replay": "messageId",
      "outer": ["sessionId", "messageId", "transferId", "nonce", "ciphertext"],
      "payload": { "version": "integer, 1", "offerId": "string, UUID", "index": "integer, item index", "transferId": "string, UUID chosen by the receiver" },
      "reply": ["files.offer", "clipboard.error"],
      "implemented": ["android", "macos"] },
    { "kind": "clipboard.error", "status": "edition-draft", "direction": "either", "feature": "clipboard_files_draft1", "encrypted": true, "replay": "messageId",
      "outer": ["sessionId", "messageId", "transferId", "nonce", "ciphertext"],
      "payload": { "version": "integer, 1", "offerId": "string", "index": "integer", "transferId": "string", "code": "expired | changed | too_large | unavailable | disabled | busy" },
      "implemented": ["android", "macos"] },
    { "kind": "files.offer", "status": "upstream-v1", "direction": "either", "feature": "files", "encrypted": true, "replay": "messageId",
      "outer": ["sessionId", "messageId", "transferId", "nonce", "ciphertext"],
      "payload": { "transferId": "string, UUID", "name": "string, display name, last path component only", "mimeType": "string", "size": "integer, bytes >= 0", "sha256": "string, base64 (optional for clipboard purpose)",
        "purpose": "edition extension: \"clipboard\" with offerId and index", "folderTransferId": "edition extension (folders_draft1)", "entry": "edition extension: manifest index", "path": "edition extension: manifest path" },
      "reply": ["files.accept", "files.rejected"],
      "implemented": ["android", "macos"] },
    { "kind": "files.accept", "status": "upstream-v1", "direction": "either", "feature": "files", "encrypted": false,
      "outer": ["sessionId", "transferId"],
      "implemented": ["android", "macos"] },
    { "kind": "files.rejected", "status": "upstream-v1", "direction": "either", "feature": "files", "encrypted": false,
      "outer": ["sessionId", "transferId"],
      "notes": "Files is off locally; sent without decrypting the offer, followed by features.update.",
      "implemented": ["android", "macos"] },
    { "kind": "files.chunk", "status": "upstream-v1", "direction": "either", "feature": "files", "encrypted": true,
      "outer": ["sessionId", "transferId", "sequence", "nonce", "ciphertext"],
      "payload": { "(raw)": "file bytes, at most 24 KiB per chunk, sequence from 0 without gaps" },
      "implemented": ["android", "macos"] },
    { "kind": "files.chunk.ack", "status": "upstream-v1", "direction": "either", "feature": "files", "encrypted": false,
      "outer": ["sessionId", "transferId", "sequence"],
      "notes": "Cumulative. The Mac keeps at most 64 chunks unacknowledged.",
      "implemented": ["android", "macos"] },
    { "kind": "files.complete", "status": "upstream-v1", "direction": "either", "feature": "files", "encrypted": true, "replay": "messageId",
      "outer": ["sessionId", "messageId", "transferId", "nonce", "ciphertext"],
      "payload": { "transferId": "string", "sha256": "string, base64 SHA-256 of all bytes" },
      "reply": ["files.complete.ack"],
      "implemented": ["android", "macos"] },
    { "kind": "files.complete.ack", "status": "upstream-v1", "direction": "either", "feature": "files", "encrypted": false,
      "outer": ["sessionId", "transferId"],
      "implemented": ["android", "macos"] },
    { "kind": "files.cancel", "status": "upstream-v1", "direction": "either", "feature": "files", "encrypted": false,
      "outer": ["sessionId", "transferId"], "reply": ["files.cancel.ack"],
      "notes": "Idempotent.",
      "implemented": ["android", "macos"] },
    { "kind": "files.cancel.ack", "status": "upstream-v1", "direction": "either", "feature": "files", "encrypted": false,
      "outer": ["sessionId", "transferId"],
      "implemented": ["android", "macos"] },
    { "kind": "notifications.post", "status": "upstream-v1", "direction": "phone-to-mac", "feature": "notifications", "encrypted": true, "replay": "messageId",
      "outer": ["sessionId", "messageId", "nonce", "ciphertext"],
      "payload": { "packageName": "string, at most 256", "applicationName": "string, at most 128", "notificationId": "string, opaque, at most 512", "title": "string, at most 1,024", "text": "string, at most 8,192",
        "timestamp": "integer, Unix ms", "applicationIcon": "string, optional base64 PNG, at most 28 KiB encoded", "callType": "optional: incoming | ongoing | screening | unknown",
        "actions": "array of at most 4 {actionToken (at most 64), title (at most 64), allowsReply}",
        "smsDefaultApp": "boolean, edition extension (sms_codes_draft1)", "redacted": "boolean, edition extension, only with smsDefaultApp true" },
      "notes": "Content is sensitive and never logged.",
      "implemented": ["android", "macos"] },
    { "kind": "notifications.remove", "status": "upstream-v1", "direction": "phone-to-mac", "feature": "notifications", "encrypted": true, "replay": "messageId",
      "outer": ["sessionId", "messageId", "nonce", "ciphertext"],
      "payload": { "notificationId": "string, at most 512", "callEnded": "boolean, optional, edition extension" },
      "implemented": ["android", "macos"] },
    { "kind": "notifications.dismiss", "status": "upstream-v1", "direction": "mac-to-phone", "feature": "notifications", "encrypted": true, "replay": "messageId",
      "outer": ["sessionId", "messageId", "nonce", "ciphertext"],
      "payload": { "notificationId": "string, at most 512" },
      "implemented": ["android", "macos"] },
    { "kind": "notifications.action", "status": "upstream-v1", "direction": "mac-to-phone", "feature": "notifications", "encrypted": true, "replay": "messageId",
      "outer": ["sessionId", "messageId", "nonce", "ciphertext"],
      "payload": { "notificationId": "string, at most 512", "actionToken": "string, at most 64", "reply": "string, optional, at most 4,096" },
      "notes": "Android runs only tokens it retained for the still active notification.",
      "implemented": ["android", "macos"] },
    { "kind": "codes.status", "status": "edition-draft", "direction": "phone-to-mac", "feature": "sms_codes_draft1", "encrypted": true, "replay": "messageId", "maxPlaintextBytes": 1024,
      "outer": ["sessionId", "messageId", "nonce", "ciphertext"],
      "payload": { "version": "integer, 1", "status": "allowed | hidden | not_linked" },
      "implemented": ["android", "macos"] },
    { "kind": "codes.link_request", "status": "edition-draft", "direction": "mac-to-phone", "feature": "sms_codes_draft1", "encrypted": true, "replay": "messageId", "maxPlaintextBytes": 1024,
      "outer": ["sessionId", "messageId", "nonce", "ciphertext"],
      "payload": { "version": "integer, 1" },
      "implemented": ["android", "macos"] },
    { "kind": "codes.advertise", "status": "edition-draft", "direction": "phone-to-mac", "feature": "sms_codes_draft1", "encrypted": true, "replay": "messageId", "maxPlaintextBytes": 1024,
      "outer": ["sessionId", "messageId", "nonce", "ciphertext"],
      "payload": { "version": "integer, 1", "serviceUuid": "string, random UUID per attempt" },
      "reply": ["codes.advertise_result"],
      "implemented": ["android", "macos"] },
    { "kind": "codes.advertise_result", "status": "edition-draft", "direction": "mac-to-phone", "feature": "sms_codes_draft1", "encrypted": true, "replay": "messageId", "maxPlaintextBytes": 1024,
      "outer": ["sessionId", "messageId", "nonce", "ciphertext"],
      "payload": { "version": "integer, 1", "serviceUuid": "string", "ok": "boolean", "reason": "when not ok: bluetooth_off | unauthorized | unsupported | failed" },
      "implemented": ["android", "macos"] },
    { "kind": "codes.advertise_stop", "status": "edition-draft", "direction": "phone-to-mac", "feature": "sms_codes_draft1", "encrypted": true, "replay": "messageId", "maxPlaintextBytes": 1024,
      "outer": ["sessionId", "messageId", "nonce", "ciphertext"],
      "payload": { "version": "integer, 1", "serviceUuid": "string", "linked": "boolean" },
      "implemented": ["android", "macos"] },
    { "kind": "quick.request", "status": "upstream-v1", "direction": "either", "feature": "links | media", "encrypted": true, "replay": "sequence", "maxPlaintextBytes": 8192,
      "outer": ["sessionId", "messageId", "nonce", "ciphertext"],
      "payload": { "version": "integer, 1", "requestId": "string, UUID", "feature": "links | media", "action": "string (links: offer; media: toggle | pause | next | previous | seek | volume)", "value": "string (links: http(s) URL, at most 4,096 bytes; seek 0 to 604800; volume 0 to 100)", "sequence": "integer, 1 to 2^53-1, per feature high-water mark" },
      "reply": ["quick.result"],
      "implemented": ["android", "macos"] },
    { "kind": "quick.result", "status": "upstream-v1", "direction": "either", "feature": "links | media", "encrypted": true, "replay": "messageId", "maxPlaintextBytes": 8192,
      "outer": ["sessionId", "messageId", "nonce", "ciphertext"],
      "payload": { "version": "integer, 1", "requestId": "string, echoes the request", "feature": "string, echoes the request", "accepted": "boolean" },
      "implemented": ["android", "macos"] },
    { "kind": "media.state", "status": "upstream-v1", "direction": "mac-to-phone", "feature": "media", "encrypted": true, "replay": "messageId", "maxPlaintextBytes": 32768,
      "outer": ["sessionId", "messageId", "nonce", "ciphertext"],
      "payload": { "version": "integer, 1", "player": "string", "title": "string, at most 256 chars", "artist": "string, at most 256 chars", "playing": "boolean", "position": "integer, 0 to 604800", "duration": "integer, 0 to 604800", "volume": "integer, 0 to 100", "detail": "string, bounded", "artwork": "string, optional base64 JPEG, at most 16 KiB, at most 128x128" },
      "implemented": ["android", "macos"] },
    { "kind": "battery.update", "status": "upstream-v1", "direction": "either", "feature": "battery", "encrypted": true, "replay": "messageId",
      "outer": ["sessionId", "messageId", "nonce", "ciphertext"],
      "payload": { "level": "integer, 0 to 100", "isCharging": "boolean" },
      "implemented": ["android", "macos"] },
    { "kind": "find.start", "status": "upstream-v1", "direction": "either", "feature": "find_device", "encrypted": true, "replay": "messageId",
      "outer": ["sessionId", "messageId", "nonce", "ciphertext"],
      "payload": { "alertId": "string, opaque" },
      "reply": ["find.started", "find.stopped"],
      "implemented": ["android", "macos"] },
    { "kind": "find.stop", "status": "upstream-v1", "direction": "either", "feature": "find_device", "encrypted": true, "replay": "messageId",
      "outer": ["sessionId", "messageId", "nonce", "ciphertext"],
      "payload": { "alertId": "string, opaque" },
      "reply": ["find.stopped"],
      "implemented": ["android", "macos"] },
    { "kind": "find.started", "status": "upstream-v1", "direction": "either", "feature": "find_device", "encrypted": true, "replay": "messageId",
      "outer": ["sessionId", "messageId", "nonce", "ciphertext"],
      "payload": { "alertId": "string, opaque" },
      "implemented": ["android", "macos"] },
    { "kind": "find.stopped", "status": "upstream-v1", "direction": "either", "feature": "find_device", "encrypted": true, "replay": "messageId",
      "outer": ["sessionId", "messageId", "nonce", "ciphertext"],
      "payload": { "alertId": "string, opaque" },
      "implemented": ["android", "macos"] },
    { "kind": "ping.request", "status": "upstream-v1", "direction": "either", "feature": "ping", "encrypted": true, "replay": "messageId",
      "outer": ["sessionId", "messageId", "nonce", "ciphertext"],
      "payload": { "version": "integer, 1" },
      "reply": ["ping.ack"],
      "implemented": ["android", "macos"] },
    { "kind": "ping.ack", "status": "upstream-v1", "direction": "either", "feature": "ping", "encrypted": false,
      "outer": ["sessionId", "messageId"],
      "notes": "messageId is the request's ID. Senders time out after five seconds.",
      "implemented": ["android", "macos"] },
    { "kind": "calls.request", "status": "upstream-v1", "direction": "mac-to-phone", "feature": "calls", "encrypted": true, "replay": "messageId",
      "outer": ["sessionId", "messageId", "nonce", "ciphertext"],
      "payload": { "number": "string, 3 to 15 digits with optional leading +; spaces, parentheses, dots and hyphens are removed" },
      "reply": ["calls.started", "calls.confirmation_required", "calls.rejected"],
      "notes": "At most one request every three seconds.",
      "implemented": ["android", "macos"] },
    { "kind": "calls.started", "status": "upstream-v1", "direction": "phone-to-mac", "feature": "calls", "encrypted": false,
      "outer": ["sessionId", "messageId"],
      "implemented": ["android", "macos"] },
    { "kind": "calls.confirmation_required", "status": "upstream-v1", "direction": "phone-to-mac", "feature": "calls", "encrypted": false,
      "outer": ["sessionId", "messageId"],
      "implemented": ["android", "macos"] },
    { "kind": "calls.rejected", "status": "upstream-v1", "direction": "phone-to-mac", "feature": "calls", "encrypted": false,
      "outer": ["sessionId", "messageId"],
      "implemented": ["android", "macos"] },
    { "kind": "input.session.start", "status": "edition-draft", "direction": "controller-to-host", "feature": "remote_input_draft1", "encrypted": true, "replay": "sequence", "maxPlaintextBytes": 2048,
      "outer": ["sessionId", "messageId", "nonce", "ciphertext"],
      "payload": { "version": "integer, 1", "inputSessionId": "string, UUID, used once", "sequence": "integer, 1 to 2^53-1", "mode": "touchpad | presentation" },
      "reply": ["input.session.started", "input.session.stop"],
      "notes": "A phone that receives it answers input.session.stop, reason unsupported.",
      "implemented": ["android", "macos"] },
    { "kind": "input.session.started", "status": "edition-draft", "direction": "host-to-controller", "feature": "remote_input_draft1", "encrypted": true, "replay": "sequence", "maxPlaintextBytes": 2048,
      "outer": ["sessionId", "messageId", "nonce", "ciphertext"],
      "payload": { "version": "integer, 1", "inputSessionId": "string", "sequence": "integer", "heartbeatSeconds": "integer, 2", "idleSeconds": "integer, 6", "limits": "{motion: 120, discrete: 20, text: 256}" },
      "implemented": ["android", "macos"] },
    { "kind": "input.session.heartbeat", "status": "edition-draft", "direction": "controller-to-host", "feature": "remote_input_draft1", "encrypted": true, "replay": "sequence", "maxPlaintextBytes": 2048,
      "outer": ["sessionId", "messageId", "nonce", "ciphertext"],
      "payload": { "version": "integer, 1", "inputSessionId": "string", "sequence": "integer" },
      "implemented": ["android", "macos"] },
