    "Bridgey" : {},
    "Bridgey can’t find that device." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bridgey не находит это устройство."
          }
        }
      }
    },
    "Bridgey can’t reach %@ right now. Send it later and it goes the next time Bridgey connects to it." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bridgey сейчас не может связаться с %@. Выберите «Отправить позже», и всё уйдёт при следующем подключении."
          }
        }
      }
    },
    "Bridgey connects while it’s open. iOS pauses it soon after you leave, and it reconnects when you come back." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bridgey на связи, пока открыт. iOS приостанавливает его вскоре после выхода, а при возвращении он подключается снова."
          }
        }
      }
    },
    "Bridgey couldn’t listen for your devices. Another app may be using its port." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bridgey не может ждать подключений от ваших устройств. Возможно, его порт занят другим приложением."
          }
        }
      }
    },
    "Bridgey couldn’t reach %@. Check you’re on the same Wi-Fi." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bridgey не может связаться с %@. Проверьте, что вы в одной сети Wi-Fi."
          }
        }
      }
    },
    "Bridgey couldn’t read or save its pairing data." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bridgey не может прочитать или сохранить данные о связанных устройствах."
          }
        }
      }
    },
    "Bridgey couldn’t use the network." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bridgey не может использовать сеть."
          }
        }
      }
    },
    "Bridgey has stopped." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bridgey остановлен."
          }
        }
      }
    },
    "Bridgey looks for your devices on this Wi-Fi and talks to them directly. Nothing goes through the internet." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bridgey ищет ваши устройства в этой сети Wi-Fi и связывается с ними напрямую. Ничего не идёт через интернет."
          }
        }
      }
    },
    "Bridgey on %@ lost access to this folder. Grant it again on the phone." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
