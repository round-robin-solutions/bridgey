        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ не показывает свой экран этому %2$@."
          }
        }
      }
    },
    "%@ doesn’t share its screen with this %@. Allow it in Bridgey on the Mac, in Settings › Remote control." : {
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ doesn’t share its screen with this %2$@. Allow it in Bridgey on the Mac, in Settings › Remote control."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ не показывает свой экран этому %2$@. Разрешите это в Bridgey на Mac: Настройки › Удалённое управление."
          }
        }
      }
    },
    "%@ doesn’t share its screen with this %@. Turn it on in Bridgey there." : {
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "new",
