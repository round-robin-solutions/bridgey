{
  "sourceLanguage" : "en-GB",
  "strings" : {
    "%@ couldn’t share its screen." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось показать экран %@."
