// Settings every target shares. scripts/rr/build-ios.sh passes the version and build number for CI and release
// builds; a local build is "<next>-dev", build 1.

// The edition's identifiers (rr-edition.properties EDITION_APP_ID). The Share extension adds ".share".
BRIDGEY_BUNDLE_ID = in.roundrobin.bridgey
BRIDGEY_APP_GROUP = group.in.roundrobin.bridgey
// Prefixed with the team ID when signed; KeychainStore falls back to the app's own Keychain without it.
BRIDGEY_KEYCHAIN_GROUP = $(AppIdentifierPrefix)in.roundrobin.bridgey.shared

// Versions (docs/rr-edition.md "Versions"). The store version is plain numbers; the edition's name goes in
// Info.plist as BridgeyVersionName.
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1
BRIDGEY_VERSION_NAME = $(MARKETING_VERSION)-dev
BRIDGEY_UPSTREAM_BASE = 0.6.0-rc.2
// Connect anywhere's control service (rr-edition.properties CONNECT_CONTROL_URL; `$()` keeps "//" from starting a
// comment). scripts/rr/build-ios.sh passes the edition's value.
BRIDGEY_CONNECT_CONTROL_URL = wss:/$()/connect.roundrobin.in/v1/ws

IPHONEOS_DEPLOYMENT_TARGET = 17.0
TARGETED_DEVICE_FAMILY = 1,2
SWIFT_VERSION = 5.0
SWIFT_INCLUDE_PATHS = $(PROJECT_DIR)/Modules
// Apple silicon simulators only; Intel Macs are not build hosts here.
EXCLUDED_ARCHS[sdk=iphonesimulator*] = x86_64

// Signing. Unsigned until the Apple Developer enrolment is confirmed (docs: ios/README.md "TestFlight").
// Put DEVELOPMENT_TEAM = <team ID> in Signing.local.xcconfig (not committed) to sign locally.
CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM =
#include? "Signing.local.xcconfig"
