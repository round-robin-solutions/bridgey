    <array>
        <dict>
            <key>NSMenuItem</key>
            <dict><key>default</key><string>Call with Bridgey RR</string></dict>
            <key>NSMessage</key>
            <string>callWithBridgey</string>
            <key>NSPortName</key>
            <string>BridgeyMac</string>
            <key>NSSendTypes</key>
            <array><string>public.utf8-plain-text</string></array>
        </dict>
    </array>
