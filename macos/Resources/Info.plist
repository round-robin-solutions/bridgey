<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>BridgeyMac</string>
    <key>CFBundleIdentifier</key>
    <string>in.roundrobin.bridgey</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>Bridgey RR</string>
	<key>CFBundleDisplayName</key>
	<string>Bridgey by Round Robin</string>
	<key>CFBundleIconFile</key>
	<string>Bridgey.icns</string>
    <key>CFBundleIconName</key>
    <string>AppIcon</string>
    <key>NSLocalNetworkUsageDescription</key>
    <string>Bridgey discovers and connects to your paired Android devices on your local network.</string>
    <key>NSAppleEventsUsageDescription</key>
    <string>When you enable media controls, Bridgey controls your selected Music or Spotify player and shares now-playing information with your paired phone. When you send the current browser tab, Bridgey reads the address of the front Safari or Chrome tab.</string>
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>Bridgey uses Bluetooth only while you link your phone, so Android can show Bridgey the codes in your text messages. Nothing connects over Bluetooth.</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_bridgey._tcp</string>
    </array>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.6.0-rr.1-dev</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <key>LSUIElement</key>
    <true/>
    <key>NSUserNotificationAlertStyle</key>
    <string>alert</string>
    <!-- Sparkle (Round Robin edition). build-app.sh adds SUFeedURL from rr-edition.properties. -->
    <key>SUPublicEDKey</key>
    <string>lbOBQU/lFebstlkZGt2hiRCB76NkkBCvRRrQPQ8vcpg=</string>
    <key>SUEnableAutomaticChecks</key>
    <true/>
    <key>SUScheduledCheckInterval</key>
    <integer>86400</integer>
