<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Reconnect when Wi-Fi returns, and dial known addresses only on the network they belong to. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Asks once (and from Settings) to keep the connection while the phone sleeps. Distributed
         outside Google Play; a companion link to a paired device is an accepted use. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <!-- Round Robin edition: self-update through PackageInstaller after the user taps Install. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Android 12+: lets an update the person chose (Install, or Update all here or on a paired device)
         install without a second tap when Bridgey updates itself. Android still asks when it must. -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- Optional background clipboard (off by default). Granted only by a one-time ADB command;
         an app installed from a download cannot hold READ_LOGS otherwise. SYSTEM_ALERT_WINDOW lets
         the read activity start from the background once that same command allows it. -->
    <uses-permission android:name="android.permission.READ_LOGS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Clipboard > Send a fresh screenshot (on by default, asked for on first use): finds a screenshot
         taken in the last minute. Selected photos only (Android 14+) is declared so it can be told
         apart from full access; it cannot see new screenshots. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- Files 2.0: the attach sheet's Photos and videos tab (asked once, inline) and, with
         "Let other devices browse this phone", the Mac's Media section. Never MANAGE_EXTERNAL_STORAGE. -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- Focus sync > Follow the Mac's Focus (off by default): Do Not Disturb access, granted by the
         person in Android's settings, lets Bridgey turn Do Not Disturb on and back off. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- Take photos for the Mac (on by default, asked for on the camera screen the first time):
         the camera a Mac asked for, opened only by a tap on the phone. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Share screen with Macs (off by default): the screen sharing service runs as a mediaProjection
         foreground service, after the person confirms in Android's own dialog, every time. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- Text messages (off by default, asked for only when it is turned on): reads conversations for the
         Mac, sends the texts written there, and shows names. Bridgey never becomes the default SMS app:
         it declares no SMS_DELIVER, WAP_PUSH_DELIVER or RESPOND_VIA_MESSAGE handler. The hidden Code
         reader test (lab builds) also reads the inbox. -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <!-- The widget's Glance library brings WorkManager, which asks to start at boot. Bridgey's widget
         redraws when the app starts, so that permission is removed from the merged manifest. -->
    <uses-permission tools:node="remove" android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <!-- Codes from messages: a companion link to the Mac (Companion Device Manager) makes Android 15+
         show Bridgey the text of code messages. Optional: phones without it use the ADB command. -->
    <uses-feature android:name="android.software.companion_device_setup" android:required="false" />

    <queries>
        <intent>
            <action android:name="android.telecom.InCallService" />
        </intent>
        <!-- Text messages, Block on phone: Android's own Blocked numbers screen (sms/BlockedNumbers.kt). -->
        <intent>
            <action android:name="android.telecom.action.MANAGE_BLOCKED_NUMBERS" />
        </intent>
        <!-- Text messages and Codes: seeing the default SMS app. Telephony.Sms.getDefaultSmsPackage only
             returns an app Bridgey may see; without these it returned null after every update until Bridgey
             happened to interact with the app (seen live on Android 16), so SMS notifications were not
             recognised. These are lookups, not handlers: Bridgey still never becomes the SMS app. -->
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <intent>
            <action android:name="android.provider.Telephony.SMS_DELIVER" />
        </intent>
        <!-- Setup asks which of these already have a Mac app (setup/SetupQuestions.kt MacTwinApps). -->
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <package android:name="org.telegram.messenger" />
        <package android:name="org.thoughtcrime.securesms" />
        <package android:name="com.Slack" />
        <package android:name="com.microsoft.teams" />
        <package android:name="com.discord" />
        <package android:name="com.facebook.orca" />
        <package android:name="com.microsoft.office.outlook" />
        <package android:name="us.zoom.videomeetings" />
    </queries>

    <application
        android:name=".BridgeyApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Bridgey">
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- Clips from the Mac: not exported; the clipboard grants a pasting app read access. -->
        <provider
            android:name=".ClipboardContentProvider"
            android:authorities="${applicationId}.clipboard"
            android:exported="false"
            android:grantUriPermissions="true" />
        <activity
            android:name=".MainActivity"
            android:documentLaunchMode="never"
            android:exported="true"
            android:label="@string/launcher_name"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ClipboardCaptureActivity"
            android:documentLaunchMode="always"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity="${applicationId}.clipboard_action"
            android:theme="@style/Theme.Bridgey.Transparent" />
        <activity
            android:name=".OpenReceivedFileActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity="" />
        <!-- Phone camera to Mac: opened from Bridgey's own notification or while Bridgey is in front. -->
        <activity
            android:name=".camera.CameraActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity="${applicationId}.camera" />
        <!-- Share screen with Macs: opens Android's capture dialog; a fresh consent every time. -->
        <activity
            android:name=".screen.ScreenConsentActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="false"
            android:taskAffinity="${applicationId}.screen"
            android:theme="@style/Theme.Bridgey.Transparent" />
        <service
            android:name=".screen.ScreenShareService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
        <receiver android:name=".screen.ScreenActionReceiver" android:exported="false" />
        <service android:name=".screen.ScreenShareTileService" android:exported="true"
            android:label="@string/tile_screen_label" android:icon="@drawable/ic_action_screen"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <activity android:name=".ConfirmCallActivity" android:exported="false"
            android:excludeFromRecents="true" android:noHistory="true" android:taskAffinity="" />
        <!-- Text messages: sent and delivered results of Bridgey's own SMS (its PendingIntents only). -->
        <receiver android:name=".sms.SmsResultReceiver" android:exported="false" />
        <service
            android:name=".BridgeyConnectionService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
        <service
            android:name=".bench.BenchService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
        <service android:name=".ClipboardTileService" android:exported="true"
            android:label="@string/tile_label" android:icon="@drawable/ic_bridgey_notification"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <!-- Mac actions (draft mac_actions_draft1): Quick Settings tile, Device Controls, widget. -->
        <service android:name=".LockMacTileService" android:exported="true"
            android:label="@string/tile_lock_label" android:icon="@drawable/ic_action_lock"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <service android:name=".controls.MacControlsService" android:exported="true" tools:targetApi="30"
            android:label="@string/feature_mac_actions"
            android:permission="android.permission.BIND_CONTROLS">
            <intent-filter><action android:name="android.service.controls.ControlsProviderService" /></intent-filter>
        </service>
        <receiver android:name=".widget.MacWidgetReceiver" android:exported="true"
            android:label="@string/widget_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/mac_widget_info" />
        </receiver>
        <activity android:name=".widget.MacWidgetConfigureActivity" android:exported="true"
            android:excludeFromRecents="true" android:taskAffinity="">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" /></intent-filter>
        </activity>
        <!-- Open on Mac (draft links_open_draft1): shows the host and waits for a tap before sending. -->
        <activity
            android:name=".OpenOnMacActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/open_on_mac_label"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Bridgey.Sheet">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".UpdateInstallReceiver"
            android:exported="false" />
        <service
            android:name=".BridgeyNotificationListenerService"
            android:exported="false"
            android:label="@string/notification_forwarding_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
