<?xml version="1.0" encoding="utf-8"?>
<!--
  The app's primary button in the notification: the Round Robin aurora (purple, blue, green, as in
  Aurora.button) in a full pill, with midnight text. Fixed colours, so it reads the same on light and
  dark shades and Material You does not tint it. Midnight on the gradient is 6.3:1 at the purple end,
  7.8:1 or more under the centred label.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33050B18">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="0"
                android:centerColor="@color/notification_aurora_blue"
                android:centerX="0.55"
                android:endColor="@color/notification_aurora_green"
                android:startColor="@color/notification_aurora_purple"
                android:type="linear" />
        </shape>
    </item>
</ripple>
