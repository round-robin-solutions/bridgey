<?xml version="1.0" encoding="utf-8"?>
<!--
  Connection notification content for DecoratedCustomViewStyle. The header already says
  "Bridgey by Round Robin", so the content is the status, then one full-width "Send copied item"
  button that is easy to hit.

  The system inflates RemoteViews with the app's theme (Theme.Material.Light), so theme attributes
  such as ?android:textColorPrimary stay dark on a dark shade. The status uses the framework
  notification text appearance instead: its colour follows the shade, light or dark, and Material You.
  The button is a fixed Round Robin aurora pill with midnight text, readable on either shade.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="2dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/notification_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" />

    <TextView
        android:id="@+id/notification_send"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/notification_send_button"
        android:gravity="center"
        android:minHeight="48dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/notification_on_aurora"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
