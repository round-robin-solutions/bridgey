    <string name="setup_q_notification_apps_summary">Kept on this phone</string>
    <string name="setup_a_notification_apps_none">None of these</string>
    <string name="setup_q_codes_title">Do you want codes from text messages shown on your Mac?</string>
    <string name="setup_q_codes_context">Android hides one-time codes from other apps until this phone is linked to your Mac. Your Mac reads them on the Mac or in the cloud, as you choose there.</string>
