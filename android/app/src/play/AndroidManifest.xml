<?xml version="1.0" encoding="utf-8"?>
<!-- Google Play build: Play installs and updates the app, and Bridgey is not the default SMS app,
     so these permissions are removed from the merged manifest (Play policy). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" tools:node="remove" />
    <!-- Lint reads these removal directives as requests; the merged manifest is checked in CI. -->
    <uses-permission android:name="android.permission.READ_SMS" tools:node="remove" tools:ignore="PermissionImpliesUnsupportedChromeOsHardware" />
    <uses-permission android:name="android.permission.SEND_SMS" tools:node="remove" tools:ignore="PermissionImpliesUnsupportedChromeOsHardware" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" tools:node="remove" tools:ignore="PermissionImpliesUnsupportedChromeOsHardware" />
    <!-- Contacts (Text messages, Calls window search) and the call log (Calls window recent calls) stay out of
         this build: its Calls window has the keypad and SIM choice only. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" tools:node="remove" tools:ignore="PermissionImpliesUnsupportedChromeOsHardware" />
    <application>
        <receiver android:name=".UpdateInstallReceiver" tools:node="remove" />
        <receiver android:name=".updates.AutoUpdateLaterReceiver" tools:node="remove" />
        <receiver android:name=".sms.SmsResultReceiver" tools:node="remove" />
        <!-- Phone control from a Mac goes through an accessibility service, which this build does not have. -->
        <service android:name=".control.BridgeyControlService" tools:node="remove" />
    </application>
</manifest>
