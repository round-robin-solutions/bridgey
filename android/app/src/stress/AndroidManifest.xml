<?xml version="1.0" encoding="utf-8"?>
<!-- Stress builds only (the "stress" build type): the control receiver a test runner drives with
     `adb shell am broadcast` (docs/testing-stress.md). Senders need DUMP, which only the shell and the system hold. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application android:label="Bridgey Stress" tools:replace="android:label">
        <receiver
            android:name=".stress.StressControlReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="${applicationId}.STRESS" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
