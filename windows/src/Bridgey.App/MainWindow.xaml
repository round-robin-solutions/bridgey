<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Bridgey.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Bridgey.ViewModels">

    <Grid x:Name="Root" AutomationProperties.AutomationId="MainRoot">
        <!-- Shown only where Mica is not available. -->
        <Border x:Name="BackdropFallback" Background="{ThemeResource BrandWindowBrush}" Visibility="Collapsed" />
        <Border Background="{ThemeResource BrandWindowTintBrush}" />
        <Grid x:Name="Chrome">
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="AppTitleBar" Padding="16,0,140,0">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Image Source="ms-appx:///Assets/AppMark.png" Width="20" Height="20" />
                    <TextBlock Text="Bridgey" FontFamily="{StaticResource BrandHeadingFont}" FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center" Foreground="{ThemeResource BrandOnBrush}" />
                </StackPanel>
            </Grid>

            <NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed"
                            IsPaneToggleButtonVisible="False" IsSettingsVisible="False" OpenPaneLength="208"
                            SelectionChanged="OnNavSelectionChanged">
                <NavigationView.MenuItems>
                    <NavigationViewItem Content="Home" Tag="home" AutomationProperties.AutomationId="NavHome">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE80F;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Notifications" Tag="notifications" AutomationProperties.AutomationId="NavNotifications">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xEA8F;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Messages" Tag="messages" AutomationProperties.AutomationId="NavMessages">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE8BD;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Calls" Tag="calls" AutomationProperties.AutomationId="NavCalls">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE717;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Pair a device" Tag="pair" AutomationProperties.AutomationId="NavPair">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE710;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.MenuItems>
                <NavigationView.FooterMenuItems>
                    <NavigationViewItem Content="Settings" Tag="settings" AutomationProperties.AutomationId="NavSettings">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE713;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.FooterMenuItems>

                <Grid x:Name="PageHost" />
            </NavigationView>

            <!-- The phone's call: who, and its own Answer, Decline or Hang up, over every page. -->
            <Border x:Name="CallCard" Grid.Row="1" Width="360" Margin="0,12,24,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Style="{StaticResource BrandCard}" CornerRadius="16" Visibility="{x:Bind Calls.HasCard, Mode=OneWay}">
                <Grid RowSpacing="12" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Image Source="ms-appx:///Assets/AppMark.png" Width="40" Height="40" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Calls.Card.Status, Mode=OneWay, FallbackValue=''}" Style="{StaticResource BrandSecondary}"
                                   AutomationProperties.Name="{x:Bind Calls.Card.Label, Mode=OneWay, FallbackValue=''}" AutomationProperties.LiveSetting="Assertive" />
                        <TextBlock Text="{x:Bind Calls.Card.Caller, Mode=OneWay, FallbackValue=''}" Style="{StaticResource BrandSectionTitle}" TextTrimming="CharacterEllipsis" MaxLines="1"
                                   AutomationProperties.AutomationId="CallCaller" />
                    </StackPanel>
                    <Button Grid.Column="2" VerticalAlignment="Top" Width="32" Height="32" Padding="0" CornerRadius="16" Click="OnHideCall"
                            AutomationProperties.Name="Hide call controls" ToolTipService.ToolTip="Hide call controls">
                        <FontIcon Glyph="&#xE711;" FontSize="11" />
                    </Button>
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="Use the phone to control this call." Style="{StaticResource BrandSecondary}"
                               Visibility="{x:Bind Calls.Card.HasNoActions, Mode=OneWay, FallbackValue=Collapsed}" />
                    <ItemsRepeater Grid.Row="1" Grid.ColumnSpan="3" ItemsSource="{x:Bind Calls.Card.Actions, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout Orientation="Horizontal" MaximumRowsOrColumns="2" ItemsStretch="Fill" MinColumnSpacing="10" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:CallActionItem">
                                <!-- Green to answer, red to end, plain otherwise; theme brushes so light and dark both follow Settings. -->
                                <Grid>
                                    <Button Content="{x:Bind Title}" Click="{x:Bind Run}" HorizontalAlignment="Stretch" Height="38" CornerRadius="10" FontWeight="SemiBold"
                                            Background="{ThemeResource BrandGoodBrush}" Foreground="{ThemeResource BrandWindowBrush}" Visibility="{x:Bind IsAnswer}"
                                            AutomationProperties.Name="{x:Bind Title}" />
                                    <Button Content="{x:Bind Title}" Click="{x:Bind Run}" HorizontalAlignment="Stretch" Height="38" CornerRadius="10" FontWeight="SemiBold"
                                            Background="{ThemeResource BrandWarnBrush}" Foreground="{ThemeResource BrandWindowBrush}" Visibility="{x:Bind IsEnd}"
                                            AutomationProperties.Name="{x:Bind Title}" />
                                    <Button Content="{x:Bind Title}" Click="{x:Bind Run}" HorizontalAlignment="Stretch" Height="38" CornerRadius="10" FontWeight="SemiBold"
                                            Visibility="{x:Bind IsOther}" AutomationProperties.Name="{x:Bind Title}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
