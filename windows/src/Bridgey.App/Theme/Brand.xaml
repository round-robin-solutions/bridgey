<?xml version="1.0" encoding="utf-8"?>
<!-- Direction B "Stream" for Windows: the Midnight Aurora palette of macos/Sources/BridgeyMac/BrandTheme.swift on
     Windows' own materials (Mica, Fluent controls). Light and dark follow Windows or Settings > General. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <!-- Fluent reads the accent from these: light theme fills use Dark1. -->
            <Color x:Key="SystemAccentColor">#006685</Color>
            <Color x:Key="SystemAccentColorLight1">#1D7E9C</Color>
            <Color x:Key="SystemAccentColorLight2">#3FA2C4</Color>
            <Color x:Key="SystemAccentColorLight3">#54C7F5</Color>
            <Color x:Key="SystemAccentColorDark1">#006685</Color>
            <Color x:Key="SystemAccentColorDark2">#005A74</Color>
            <Color x:Key="SystemAccentColorDark3">#00465A</Color>

            <SolidColorBrush x:Key="BrandWindowBrush" Color="#F4F7FA" />
            <SolidColorBrush x:Key="BrandSurfaceBrush" Color="#FFFFFF" Opacity="0.86" />
            <SolidColorBrush x:Key="BrandSurfaceAltBrush" Color="#EEF2F7" />
            <SolidColorBrush x:Key="BrandOutlineBrush" Color="#DDE3EB" />
            <SolidColorBrush x:Key="BrandOnBrush" Color="#050B18" />
            <SolidColorBrush x:Key="BrandOn2Brush" Color="#4C5262" />
            <SolidColorBrush x:Key="BrandPrimaryBrush" Color="#006685" />
            <SolidColorBrush x:Key="BrandGoodBrush" Color="#006C49" />
            <SolidColorBrush x:Key="BrandWarnBrush" Color="#B3261E" />
            <SolidColorBrush x:Key="BrandTintBlueBrush" Color="#DAF1FF" />
            <SolidColorBrush x:Key="BrandTintBlueInkBrush" Color="#005A74" />
            <SolidColorBrush x:Key="BrandTintGreenBrush" Color="#CDFFE2" />
            <SolidColorBrush x:Key="BrandTintGreenInkBrush" Color="#005236" />
            <SolidColorBrush x:Key="BrandTintPurpleBrush" Color="#EDE4FF" />
            <SolidColorBrush x:Key="BrandTintPurpleInkBrush" Color="#5A38BA" />
            <SolidColorBrush x:Key="BrandRingOffBrush" Color="#DCE3EC" />
            <SolidColorBrush x:Key="BrandCodeBrush" Color="#EEF2F7" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <!-- Dark theme fills use Light2. -->
            <Color x:Key="SystemAccentColor">#54C7F5</Color>
            <Color x:Key="SystemAccentColorLight1">#54C7F5</Color>
            <Color x:Key="SystemAccentColorLight2">#54C7F5</Color>
            <Color x:Key="SystemAccentColorLight3">#8AD9F8</Color>
            <Color x:Key="SystemAccentColorDark1">#3FA2C4</Color>
            <Color x:Key="SystemAccentColorDark2">#1D7E9C</Color>
            <Color x:Key="SystemAccentColorDark3">#006685</Color>

            <SolidColorBrush x:Key="BrandWindowBrush" Color="#050B18" />
            <SolidColorBrush x:Key="BrandSurfaceBrush" Color="#0D1321" Opacity="0.82" />
            <SolidColorBrush x:Key="BrandSurfaceAltBrush" Color="#151C29" />
            <SolidColorBrush x:Key="BrandOutlineBrush" Color="#2A303F" />
            <SolidColorBrush x:Key="BrandOnBrush" Color="#F4F7FA" />
            <SolidColorBrush x:Key="BrandOn2Brush" Color="#9AA8B8" />
            <SolidColorBrush x:Key="BrandPrimaryBrush" Color="#54C7F5" />
            <SolidColorBrush x:Key="BrandGoodBrush" Color="#5EF2B2" />
            <SolidColorBrush x:Key="BrandWarnBrush" Color="#FFB4A8" />
            <SolidColorBrush x:Key="BrandTintBlueBrush" Color="#54C7F5" Opacity="0.15" />
            <SolidColorBrush x:Key="BrandTintBlueInkBrush" Color="#6AD3FF" />
            <SolidColorBrush x:Key="BrandTintGreenBrush" Color="#5EF2B2" Opacity="0.13" />
            <SolidColorBrush x:Key="BrandTintGreenInkBrush" Color="#5EF2B2" />
            <SolidColorBrush x:Key="BrandTintPurpleBrush" Color="#9B7CFF" Opacity="0.16" />
            <SolidColorBrush x:Key="BrandTintPurpleInkBrush" Color="#CDBDFF" />
            <SolidColorBrush x:Key="BrandRingOffBrush" Color="#232A38" />
            <SolidColorBrush x:Key="BrandCodeBrush" Color="#151C29" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- The aurora: purple, blue, green. Rings of connected devices and the app mark. -->
    <LinearGradientBrush x:Key="BrandAuroraBrush" StartPoint="0,0.36" EndPoint="1,0.64">
        <GradientStop Color="#9B7CFF" Offset="0" />
        <GradientStop Color="#54C7F5" Offset="0.55" />
        <GradientStop Color="#5EF2B2" Offset="1" />
    </LinearGradientBrush>

    <FontFamily x:Key="BrandHeadingFont">ms-appx:///Assets/Fonts/space_grotesk_semibold.ttf#Space Grotesk</FontFamily>

    <Style x:Key="BrandHeadline" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BrandHeadingFont}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource BrandOnBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="BrandSectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BrandHeadingFont}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource BrandOnBrush}" />
    </Style>

    <Style x:Key="BrandBody" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource BrandOnBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="BrandSecondary" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource BrandOn2Brush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="BrandCard" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource BrandSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BrandOutlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16" />
    </Style>
</ResourceDictionary>
