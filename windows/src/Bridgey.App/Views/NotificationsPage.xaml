<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Bridgey.Views.NotificationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Bridgey.ViewModels">

    <Grid Padding="32,20,32,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <TextBlock Text="Notifications" Style="{StaticResource BrandHeadline}" AutomationProperties.AutomationId="NotificationsTitle" />
            <Button Content="Clear history" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnClearHistory"
                    Visibility="{x:Bind Settings.NotificationHistory, Mode=OneWay}" AutomationProperties.AutomationId="ClearHistory" />
        </Grid>

        <InfoBar x:Name="NoticeBar" Grid.Row="1" IsOpen="{x:Bind Notifications.HasNotice, Mode=OneWay}" Severity="Warning"
                 Message="{x:Bind Notifications.Notice, Mode=OneWay}" CloseButtonClick="OnNoticeClosed" />

        <TextBlock Grid.Row="2" Text="Notifications from your phone show up here." Style="{StaticResource BrandSecondary}"
                   Visibility="{x:Bind Notifications.HasNoItems, Mode=OneWay}" AutomationProperties.AutomationId="NoNotifications" />

        <ListView x:Name="NotificationList" Grid.Row="2" ItemsSource="{x:Bind Notifications.Items}" SelectionMode="None" IsItemClickEnabled="False"
                  AutomationProperties.AutomationId="NotificationList" Padding="0" Visibility="{x:Bind Notifications.HasItems, Mode=OneWay}">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,8" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:NotificationItem">
                    <Border Style="{StaticResource BrandCard}" Padding="14,12" AutomationProperties.Name="{x:Bind Title}">
                        <Grid ColumnSpacing="12" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind Detail}" Style="{StaticResource BrandSecondary}" />
                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" Foreground="{ThemeResource BrandOnBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind Text}" Style="{StaticResource BrandBody}" TextWrapping="Wrap" MaxLines="4" TextTrimming="CharacterEllipsis"
                                           Visibility="{x:Bind HasText}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Dismiss" VerticalAlignment="Top" Click="{x:Bind Dismiss}"
                                    Visibility="{x:Bind CanAct, Mode=OneWay}" AutomationProperties.AutomationId="DismissNotification" />

                            <!-- A one-time code, with Copy code. -->
                            <Border Grid.Row="1" Grid.ColumnSpan="2" CornerRadius="10" Padding="12,8" Background="{ThemeResource BrandTintPurpleBrush}"
                                    Visibility="{x:Bind HasCode}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind CodeText}" FontFamily="{StaticResource BrandHeadingFont}" FontSize="22" FontWeight="SemiBold"
                                               Foreground="{ThemeResource BrandTintPurpleInkBrush}" IsTextSelectionEnabled="True" VerticalAlignment="Center"
                                               AutomationProperties.AutomationId="NotificationCode" />
                                    <Button Grid.Column="1" Content="Copy code" Style="{StaticResource AccentButtonStyle}" Click="{x:Bind CopyCode}"
                                            AutomationProperties.AutomationId="CopyCode" />
                                </Grid>
                            </Border>

                            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Spacing="8">
                                <ItemsRepeater ItemsSource="{x:Bind Buttons}" Visibility="{x:Bind CanAct, Mode=OneWay}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Orientation="Horizontal" Spacing="8" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:NotificationActionItem">
                                            <Button Content="{x:Bind Title}" Click="{x:Bind Run}" />
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                                <Grid ColumnSpacing="8" Visibility="{x:Bind CanReply, Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{x:Bind Reply, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Reply"
                                             AutomationProperties.AutomationId="ReplyBox" />
                                    <Button Grid.Column="1" Content="Send" Style="{StaticResource AccentButtonStyle}" Click="{x:Bind SendReply}"
                                            IsEnabled="{x:Bind CanSendReply, Mode=OneWay}" AutomationProperties.AutomationId="SendReply" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
