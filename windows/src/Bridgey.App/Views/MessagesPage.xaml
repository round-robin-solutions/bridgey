<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Bridgey.Views.MessagesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Bridgey.ViewModels"
    xmlns:views="using:Bridgey.Views">

    <Grid Padding="32,20,32,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Messages" Style="{StaticResource BrandHeadline}" AutomationProperties.AutomationId="MessagesTitle" />
                <TextBlock Text="{x:Bind Messages.Status, Mode=OneWay}" Style="{StaticResource BrandSecondary}" Visibility="{x:Bind Messages.HasStatus, Mode=OneWay}"
                           AutomationProperties.AutomationId="MessagesStatus" />
            </StackPanel>
            <ComboBox Grid.Column="1" VerticalAlignment="Center" MinWidth="160" ItemsSource="{x:Bind Messages.Phones}"
                      SelectedItem="{x:Bind Messages.SelectedPhone, Mode=TwoWay}" Visibility="{x:Bind Messages.HasManyPhones, Mode=OneWay}"
                      AutomationProperties.Name="Phone" AutomationProperties.AutomationId="MessagesPhone" />
            <Button Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource AccentButtonStyle}" Click="OnNewMessage"
                    IsEnabled="{x:Bind Messages.IsAvailable, Mode=OneWay}" Visibility="{x:Bind Messages.HasPhone, Mode=OneWay}"
                    AutomationProperties.AutomationId="NewMessage" ToolTipService.ToolTip="New message (Ctrl+N)">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Control" Key="N" />
                </Button.KeyboardAccelerators>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock Text="New message" />
                </StackPanel>
            </Button>
        </Grid>

        <InfoBar x:Name="NoticeBar" Grid.Row="1" IsOpen="{x:Bind Messages.HasNotice, Mode=OneWay}" Severity="Informational"
                 Message="{x:Bind Messages.Notice, Mode=OneWay}" CloseButtonClick="OnNoticeClosed" AutomationProperties.AutomationId="MessagesNotice" />

        <!-- No phone with Text messages yet. -->
        <StackPanel Grid.Row="2" Spacing="12" MaxWidth="440" HorizontalAlignment="Left" Visibility="{x:Bind Messages.HasNoPhone, Mode=OneWay}"
                    AutomationProperties.AutomationId="MessagesOff">
            <TextBlock Text="Turn on Text messages here and in Bridgey on your phone, and your phone's texts show up here." Style="{StaticResource BrandBody}" />
            <Button Content="Open Settings" Click="OnOpenSettings" AutomationProperties.AutomationId="MessagesSettings" />
        </StackPanel>

        <Grid Grid.Row="2" ColumnSpacing="16" Visibility="{x:Bind Messages.HasPhone, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Conversations, unread first. -->
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <SelectorBar x:Name="Filter" SelectionChanged="OnFilterChanged" AutomationProperties.Name="Show" AutomationProperties.AutomationId="MessagesFilter">
                    <SelectorBarItem Text="All" IsSelected="True" AutomationProperties.AutomationId="FilterAll" />
                    <SelectorBarItem Text="Unread" AutomationProperties.AutomationId="FilterUnread" />
                </SelectorBar>
                <TextBlock Grid.Row="1" Text="No conversations yet." Style="{StaticResource BrandSecondary}" Margin="12,8"
                           Visibility="{x:Bind Messages.HasNoConversations, Mode=OneWay}" AutomationProperties.AutomationId="NoConversations" />
                <ListView x:Name="ConversationList" Grid.Row="1" ItemsSource="{x:Bind Messages.Conversations}" SelectionMode="Single"
                          SelectedItem="{x:Bind Messages.Selected, Mode=TwoWay}"
                          AutomationProperties.Name="Conversations" AutomationProperties.AutomationId="Conversations">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ConversationItem">
                            <Grid ColumnSpacing="12" Padding="0,10" AutomationProperties.Name="{x:Bind Label, Mode=OneWay}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="36" Height="36" VerticalAlignment="Top">
                                    <Ellipse Fill="{ThemeResource BrandTintBlueBrush}" />
                                    <TextBlock Text="{x:Bind Initial, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontFamily="{StaticResource BrandHeadingFont}" FontWeight="SemiBold" Foreground="{ThemeResource BrandTintBlueInkBrush}" />
                                </Grid>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontWeight="{x:Bind views:MessagesPage.Weight(IsUnread), Mode=OneWay}"
                                               Foreground="{ThemeResource BrandOnBrush}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                    <TextBlock Text="{x:Bind Snippet, Mode=OneWay}" Style="{StaticResource BrandSecondary}" TextTrimming="CharacterEllipsis" MaxLines="1" TextWrapping="NoWrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="4" HorizontalAlignment="Right">
                                    <TextBlock Text="{x:Bind Time, Mode=OneWay}" Style="{StaticResource BrandSecondary}" FontSize="12" HorizontalAlignment="Right" />
                                    <Border Background="{ThemeResource BrandPrimaryBrush}" CornerRadius="9" MinWidth="18" Height="18" Padding="5,0" HorizontalAlignment="Right"
                                            Visibility="{x:Bind IsUnread, Mode=OneWay}">
                                        <TextBlock Text="{x:Bind UnreadText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource BrandWindowBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Mark as read" Click="{x:Bind MarkRead}" />
                                        <MenuFlyoutItem Text="Mark as unread" Click="{x:Bind MarkUnread}" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Block on phone" Click="{x:Bind BlockOnPhone}" />
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Button Grid.Row="2" Content="Show older" HorizontalAlignment="Stretch" Click="OnOlderConversations" Visibility="{x:Bind Messages.HasMoreConversations, Mode=OneWay}"
                        AutomationProperties.AutomationId="OlderConversations" />
            </Grid>

            <!-- The open conversation, or a new message. -->
            <Border x:Name="ThreadPanel" Grid.Column="1" Style="{StaticResource BrandCard}" Padding="0">
                <Grid>
                    <TextBlock Text="Choose a conversation." Style="{StaticResource BrandSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{x:Bind Messages.HasNoSelection, Mode=OneWay}" />
                    <Grid RowSpacing="0" Visibility="{x:Bind Messages.HasThread, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Padding="20,14" Spacing="8" BorderBrush="{ThemeResource BrandOutlineBrush}" BorderThickness="0,0,0,1">
                            <StackPanel>
                                <TextBlock Text="{x:Bind Messages.Title, Mode=OneWay}" Style="{StaticResource BrandSectionTitle}" AutomationProperties.AutomationId="ThreadTitle"
                                           AutomationProperties.HeadingLevel="Level2" />
                                <TextBlock Text="{x:Bind Messages.Subtitle, Mode=OneWay}" Style="{StaticResource BrandSecondary}" IsTextSelectionEnabled="True"
                                           Visibility="{x:Bind views:MessagesPage.Any(Messages.Subtitle), Mode=OneWay}" />
                            </StackPanel>
                            <TextBox x:Name="ToBox" PlaceholderText="Name or number" Text="{x:Bind Messages.To, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{x:Bind Messages.Composing, Mode=OneWay}" AutomationProperties.Name="To" AutomationProperties.AutomationId="MessageTo" />
                        </StackPanel>

                        <!-- Contacts the phone found for a new message. -->
                        <ListView Grid.Row="1" ItemsSource="{x:Bind Messages.Contacts}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnContactClicked"
                                  Visibility="{x:Bind Messages.Composing, Mode=OneWay}" AutomationProperties.Name="Contacts" AutomationProperties.AutomationId="MessageContacts">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:ContactItem">
                                    <StackPanel Padding="0,8" AutomationProperties.Name="{x:Bind Name}">
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource BrandBody}" />
                                        <TextBlock Text="{x:Bind Detail}" Style="{StaticResource BrandSecondary}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <ListView x:Name="MessageList" Grid.Row="1" ItemsSource="{x:Bind Messages.Messages}" SelectionMode="None" Padding="12,8"
                                  Visibility="{x:Bind Messages.HasSelection, Mode=OneWay}" AutomationProperties.Name="Messages" AutomationProperties.AutomationId="MessageList">
                            <ListView.Header>
                                <Button Content="Earlier messages" HorizontalAlignment="Center" Margin="0,4,0,8" Click="OnOlderMessages"
                                        Visibility="{x:Bind Messages.HasOlder, Mode=OneWay}" AutomationProperties.AutomationId="OlderMessages" />
                            </ListView.Header>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="4,2" />
                                    <Setter Property="IsTabStop" Value="False" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:MessageItem">
                                    <StackPanel HorizontalAlignment="{x:Bind views:MessagesPage.Side(Incoming), Mode=OneWay}" MaxWidth="440" Spacing="2" Margin="0,3"
                                                AutomationProperties.Name="{x:Bind Label, Mode=OneWay}">
                                        <Border CornerRadius="16" Padding="12,8" Background="{x:Bind views:MessagesPage.Bubble(Incoming), Mode=OneWay}">
                                            <StackPanel Spacing="6">
                                                <Image Source="{x:Bind views:MessagesPage.Picture(Image), Mode=OneWay}" MaxHeight="280" MaxWidth="280" Stretch="Uniform"
                                                       Visibility="{x:Bind HasImage, Mode=OneWay}" AutomationProperties.Name="Picture" />
                                                <TextBlock Text="Picture didn't load" Style="{StaticResource BrandSecondary}" Visibility="{x:Bind ImageFailed, Mode=OneWay}" />
                                                <TextBlock Text="{x:Bind Body, Mode=OneWay}" Style="{StaticResource BrandBody}" IsTextSelectionEnabled="True"
                                                           Visibility="{x:Bind HasBody, Mode=OneWay}" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="{x:Bind Meta, Mode=OneWay}" Style="{StaticResource BrandSecondary}" FontSize="11"
                                                   HorizontalAlignment="{x:Bind views:MessagesPage.Side(Incoming), Mode=OneWay}" Margin="8,0" />
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Visibility="{x:Bind CanRetry, Mode=OneWay}">
                                            <Button Content="Try again" Click="{x:Bind Retry}" AutomationProperties.AutomationId="RetrySend" />
                                            <Button Content="Delete" Click="{x:Bind Discard}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- The composer. Group conversations are answered on the phone. -->
                        <Grid Grid.Row="2" Padding="16,12" ColumnSpacing="8" BorderBrush="{ThemeResource BrandOutlineBrush}" BorderThickness="0,1,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.ColumnSpan="3" Text="Answer group conversations on your phone." Style="{StaticResource BrandSecondary}"
                                       Visibility="{x:Bind Messages.IsGroup, Mode=OneWay}" />
                            <ComboBox ItemsSource="{x:Bind Messages.Sims}" SelectedItem="{x:Bind Messages.Sim, Mode=TwoWay}"
                                      DisplayMemberPath="Label" Visibility="{x:Bind views:MessagesPage.Both(Messages.HasSims, Messages.IsGroup), Mode=OneWay}"
                                      AutomationProperties.Name="SIM" AutomationProperties.AutomationId="MessageSim" />
                            <TextBox x:Name="DraftBox" Grid.Column="1" PlaceholderText="Text message" Text="{x:Bind Messages.Draft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="2000" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="120" PreviewKeyDown="OnDraftKeyDown" Visibility="{x:Bind views:MessagesPage.Not(Messages.IsGroup), Mode=OneWay}"
                                     AutomationProperties.Name="Text message" AutomationProperties.AutomationId="MessageDraft" />
                            <Button Grid.Column="2" Style="{StaticResource AccentButtonStyle}" Click="OnSend" IsEnabled="{x:Bind Messages.CanSendDraft, Mode=OneWay}"
                                    Visibility="{x:Bind views:MessagesPage.Not(Messages.IsGroup), Mode=OneWay}" AutomationProperties.Name="Send" AutomationProperties.AutomationId="SendMessage"
                                    ToolTipService.ToolTip="Send (Enter)">
                                <FontIcon Glyph="&#xE724;" FontSize="16" />
                            </Button>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
