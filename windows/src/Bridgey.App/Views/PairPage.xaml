<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Bridgey.Views.PairPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Bridgey.ViewModels">

    <ScrollViewer Padding="32,20,32,24">
        <StackPanel Spacing="20" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="{x:Bind Pairing.Title, Mode=OneWay}" Style="{StaticResource BrandHeadline}"
                       AutomationProperties.AutomationId="PairingTitle" />

            <!-- Choose a device nearby, or type an address. -->
            <StackPanel x:Name="ChoosePanel" Spacing="16" Visibility="{x:Bind Pairing.IsChoosing, Mode=OneWay}">
                <TextBlock Text="Open Bridgey on your phone or Mac on the same network, then choose it below. While this screen is open, it can pair from its side too."
                           Style="{StaticResource BrandSecondary}" />

                <ItemsRepeater ItemsSource="{x:Bind Pairing.Nearby}" AutomationProperties.AutomationId="Nearby">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="8" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:NearbyItem">
                            <Button Click="{x:Bind Pair}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="14,12"
                                    Background="{ThemeResource BrandSurfaceBrush}" BorderBrush="{ThemeResource BrandOutlineBrush}" CornerRadius="12"
                                    AutomationProperties.Name="{x:Bind Name}">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="20" Background="{ThemeResource BrandTintBlueBrush}">
                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" Foreground="{ThemeResource BrandTintBlueInkBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" Foreground="{ThemeResource BrandOnBrush}" />
                                        <TextBlock Text="{x:Bind Detail}" Style="{StaticResource BrandSecondary}" />
                                    </StackPanel>
                                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource BrandOn2Brush}" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <Border Style="{StaticResource BrandCard}" Visibility="{x:Bind Pairing.HasNoNearby, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ProgressRing IsActive="True" Width="18" Height="18" />
                        <TextBlock Text="Looking for devices on this network" Style="{StaticResource BrandSecondary}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <StackPanel Spacing="8">
                    <TextBlock Text="Or pair by address" Style="{StaticResource BrandSectionTitle}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="360" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{x:Bind Pairing.Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="192.168.1.20 or a Tailscale address" AutomationProperties.AutomationId="PairAddress"
                                 KeyDown="OnAddressKeyDown" />
                        <Button Grid.Column="1" Content="Pair" Click="OnPairByAddress" IsEnabled="{x:Bind Pairing.CanPairByAddress, Mode=OneWay}"
                                AutomationProperties.AutomationId="PairByAddress" />
                    </Grid>
                </StackPanel>
            </StackPanel>

            <!-- Connecting, or waiting for the other device to allow pairing. -->
            <StackPanel x:Name="BusyPanel" Spacing="16" Visibility="{x:Bind Pairing.IsBusy, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <ProgressRing IsActive="{x:Bind Pairing.IsBusy, Mode=OneWay}" Width="22" Height="22" />
                    <TextBlock Text="{x:Bind Pairing.Message, Mode=OneWay}" Style="{StaticResource BrandBody}" VerticalAlignment="Center" MaxWidth="560" />
                </StackPanel>
                <Button Content="Cancel" Click="OnCancel" />
            </StackPanel>

            <!-- The code, the same on both devices. -->
            <StackPanel x:Name="CodePanel" Spacing="20" Visibility="{x:Bind Pairing.IsCode, Mode=OneWay}">
                <Border Background="{ThemeResource BrandCodeBrush}" CornerRadius="16" Padding="28,20" HorizontalAlignment="Left"
                        BorderBrush="{StaticResource BrandAuroraBrush}" BorderThickness="2">
                    <TextBlock Text="{x:Bind Pairing.Code, Mode=OneWay}" FontFamily="{StaticResource BrandHeadingFont}" FontSize="48"
                               FontWeight="SemiBold" CharacterSpacing="80" Foreground="{ThemeResource BrandOnBrush}"
                               AutomationProperties.AutomationId="PairingCode" />
                </Border>
                <TextBlock Text="{x:Bind Pairing.Message, Mode=OneWay}" Style="{StaticResource BrandBody}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="The codes match" Style="{StaticResource AccentButtonStyle}" Click="OnConfirm"
                            AutomationProperties.AutomationId="ConfirmCode" />
                    <Button Content="They don't match" Click="OnReject" AutomationProperties.AutomationId="RejectCode" />
                </StackPanel>
            </StackPanel>

            <!-- Paired. -->
            <StackPanel x:Name="DonePanel" Spacing="16" Visibility="{x:Bind Pairing.IsDone, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border Width="40" Height="40" CornerRadius="20" Background="{ThemeResource BrandTintGreenBrush}">
                        <FontIcon Glyph="&#xE73E;" FontSize="18" Foreground="{ThemeResource BrandTintGreenInkBrush}" />
                    </Border>
                    <TextBlock Text="{x:Bind Pairing.Message, Mode=OneWay}" Style="{StaticResource BrandBody}" VerticalAlignment="Center" MaxWidth="560" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Go to Home" Style="{StaticResource AccentButtonStyle}" Click="OnHome" AutomationProperties.AutomationId="PairedHome" />
                    <Button Content="Pair another device" Click="OnAgain" />
                </StackPanel>
            </StackPanel>

            <!-- Not paired. -->
            <StackPanel x:Name="FailedPanel" Spacing="16" Visibility="{x:Bind Pairing.IsFailed, Mode=OneWay}">
                <TextBlock Text="{x:Bind Pairing.Message, Mode=OneWay}" Style="{StaticResource BrandBody}" AutomationProperties.AutomationId="PairingMessage" />
                <Button Content="Try again" Style="{StaticResource AccentButtonStyle}" Click="OnAgain" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
