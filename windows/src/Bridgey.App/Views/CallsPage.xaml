<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Bridgey.Views.CallsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Bridgey.ViewModels"
    xmlns:views="using:Bridgey.Views">

    <UserControl.Resources>
        <Style x:Key="KeyButton" TargetType="Button">
            <Setter Property="Width" Value="64" />
            <Setter Property="Height" Value="52" />
            <Setter Property="CornerRadius" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Background" Value="{ThemeResource BrandSurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource BrandOutlineBrush}" />
        </Style>
        <Style x:Key="RowAction" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid Padding="32,20,32,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Calls" Style="{StaticResource BrandHeadline}" AutomationProperties.AutomationId="CallsTitle" />
            <ComboBox Grid.Column="1" VerticalAlignment="Center" MinWidth="160" ItemsSource="{x:Bind Calls.Phones}"
                      SelectedItem="{x:Bind Calls.SelectedPhone, Mode=TwoWay}" Visibility="{x:Bind Calls.HasManyPhones, Mode=OneWay}"
                      AutomationProperties.Name="Phone" AutomationProperties.AutomationId="CallsPhone" />
        </Grid>

        <!-- What happened to the last call, or the SIM question. -->
        <StackPanel Grid.Row="1" Spacing="8">
            <InfoBar x:Name="SimBar" IsOpen="{x:Bind Calls.IsAskingSim, Mode=OneWay}" Severity="Informational" Title="Call from which SIM?"
                     CloseButtonClick="OnSimCancelled" AutomationProperties.AutomationId="SimQuestion">
                <InfoBar.Content>
                    <ItemsRepeater ItemsSource="{x:Bind Calls.Sims}" Margin="0,0,0,12">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Horizontal" Spacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:SimChoice">
                                <Button Content="{x:Bind Label}" Click="OnSimChosen" Tag="{x:Bind}" AutomationProperties.Name="{x:Bind Label}" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </InfoBar.Content>
            </InfoBar>
            <InfoBar x:Name="NoticeBar" IsOpen="{x:Bind Calls.HasNotice, Mode=OneWay}" Severity="{x:Bind views:CallsPage.Severity(Calls.NoticeGood), Mode=OneWay}"
                     Message="{x:Bind Calls.Notice, Mode=OneWay}" CloseButtonClick="OnNoticeClosed" AutomationProperties.AutomationId="CallsNotice" />
        </StackPanel>

        <!-- No phone to call through yet. -->
        <StackPanel Grid.Row="2" Spacing="12" MaxWidth="460" HorizontalAlignment="Left" Visibility="{x:Bind Calls.HasNoPhone, Mode=OneWay}">
            <TextBlock Text="Call through your phone from this PC. Turn on the Calls window here, allow your phone, and allow this PC in Bridgey on the phone."
                       Style="{StaticResource BrandBody}" AutomationProperties.AutomationId="CallsOff" />
            <Button Content="Open Settings" Click="OnOpenSettings" AutomationProperties.AutomationId="CallsSettings" />
        </StackPanel>

        <Grid Grid.Row="2" ColumnSpacing="24" Visibility="{x:Bind Calls.HasPhone, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- The field, the keypad, the SIM and Call. -->
            <StackPanel Spacing="14">
                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="QueryBox" PlaceholderText="Name or number" Text="{x:Bind Calls.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="{x:Bind views:CallsPage.FieldSize(Calls.QueryIsNumber), Mode=OneWay}" KeyDown="OnQueryKeyDown"
                             AutomationProperties.Name="Name or number" AutomationProperties.AutomationId="CallsQuery" />
                    <Button Grid.Column="1" Click="OnClear" Visibility="{x:Bind Calls.HasQuery, Mode=OneWay}" Style="{StaticResource RowAction}"
                            AutomationProperties.Name="Clear" ToolTipService.ToolTip="Clear (Esc)">
                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                    </Button>
                </Grid>

                <Grid HorizontalAlignment="Center" RowSpacing="10" ColumnSpacing="14" AutomationProperties.Name="Keypad">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource KeyButton}" Tag="1" Click="OnKey" AutomationProperties.Name="1"><TextBlock Text="1" FontSize="20" /></Button>
                    <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource KeyButton}" Tag="2" Click="OnKey" AutomationProperties.Name="2"><StackPanel><TextBlock Text="2" FontSize="20" HorizontalAlignment="Center" /><TextBlock Text="ABC" FontSize="9" Opacity="0.7" HorizontalAlignment="Center" /></StackPanel></Button>
                    <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource KeyButton}" Tag="3" Click="OnKey" AutomationProperties.Name="3"><StackPanel><TextBlock Text="3" FontSize="20" HorizontalAlignment="Center" /><TextBlock Text="DEF" FontSize="9" Opacity="0.7" HorizontalAlignment="Center" /></StackPanel></Button>
                    <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource KeyButton}" Tag="4" Click="OnKey" AutomationProperties.Name="4"><StackPanel><TextBlock Text="4" FontSize="20" HorizontalAlignment="Center" /><TextBlock Text="GHI" FontSize="9" Opacity="0.7" HorizontalAlignment="Center" /></StackPanel></Button>
                    <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource KeyButton}" Tag="5" Click="OnKey" AutomationProperties.Name="5"><StackPanel><TextBlock Text="5" FontSize="20" HorizontalAlignment="Center" /><TextBlock Text="JKL" FontSize="9" Opacity="0.7" HorizontalAlignment="Center" /></StackPanel></Button>
                    <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource KeyButton}" Tag="6" Click="OnKey" AutomationProperties.Name="6"><StackPanel><TextBlock Text="6" FontSize="20" HorizontalAlignment="Center" /><TextBlock Text="MNO" FontSize="9" Opacity="0.7" HorizontalAlignment="Center" /></StackPanel></Button>
                    <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource KeyButton}" Tag="7" Click="OnKey" AutomationProperties.Name="7"><StackPanel><TextBlock Text="7" FontSize="20" HorizontalAlignment="Center" /><TextBlock Text="PQRS" FontSize="9" Opacity="0.7" HorizontalAlignment="Center" /></StackPanel></Button>
                    <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource KeyButton}" Tag="8" Click="OnKey" AutomationProperties.Name="8"><StackPanel><TextBlock Text="8" FontSize="20" HorizontalAlignment="Center" /><TextBlock Text="TUV" FontSize="9" Opacity="0.7" HorizontalAlignment="Center" /></StackPanel></Button>
                    <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource KeyButton}" Tag="9" Click="OnKey" AutomationProperties.Name="9"><StackPanel><TextBlock Text="9" FontSize="20" HorizontalAlignment="Center" /><TextBlock Text="WXYZ" FontSize="9" Opacity="0.7" HorizontalAlignment="Center" /></StackPanel></Button>
                    <Button Grid.Row="3" Grid.Column="0" Style="{StaticResource KeyButton}" Tag="+" Click="OnKey" AutomationProperties.Name="Plus"><TextBlock Text="+" FontSize="20" /></Button>
                    <Button Grid.Row="3" Grid.Column="1" Style="{StaticResource KeyButton}" Tag="0" Click="OnKey" AutomationProperties.Name="0"><TextBlock Text="0" FontSize="20" /></Button>
                    <Button Grid.Row="3" Grid.Column="2" Style="{StaticResource KeyButton}" Click="OnBackspace" AutomationProperties.Name="Delete"><FontIcon Glyph="&#xE750;" FontSize="16" /></Button>
                </Grid>

                <ComboBox HorizontalAlignment="Stretch" Header="Call from" ItemsSource="{x:Bind Calls.Sims}" SelectedItem="{x:Bind Calls.Sim, Mode=TwoWay}"
                          DisplayMemberPath="Label" PlaceholderText="Ask each time" Visibility="{x:Bind Calls.HasSims, Mode=OneWay}"
                          AutomationProperties.Name="Call from" AutomationProperties.AutomationId="CallsSim" />

                <Button HorizontalAlignment="Stretch" Height="44" CornerRadius="22" Click="OnCall" IsEnabled="{x:Bind Calls.CanCall, Mode=OneWay}"
                        Background="{ThemeResource BrandGoodBrush}" Foreground="{ThemeResource BrandWindowBrush}"
                        AutomationProperties.Name="Call" AutomationProperties.AutomationId="CallButton" ToolTipService.ToolTip="Call (Enter)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE717;" FontSize="16" />
                        <TextBlock Text="Call" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Recent calls, or what was typed. -->
            <Grid Grid.Column="1" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{x:Bind Calls.ListTitle, Mode=OneWay}" Style="{StaticResource BrandSectionTitle}" AutomationProperties.HeadingLevel="Level2" />
                    <ProgressRing IsActive="{x:Bind Calls.Searching, Mode=OneWay}" Width="16" Height="16" />
                </StackPanel>
                <TextBlock Grid.Row="1" Text="{x:Bind Calls.EmptyText, Mode=OneWay}" Style="{StaticResource BrandSecondary}" MaxWidth="360" HorizontalAlignment="Left"
                           Visibility="{x:Bind Calls.HasEmptyText, Mode=OneWay}" AutomationProperties.AutomationId="CallsEmpty" />
                <ListView x:Name="RowList" Grid.Row="1" ItemsSource="{x:Bind Calls.Rows}" SelectionMode="Single" SelectedItem="{x:Bind Calls.SelectedRow, Mode=TwoWay}"
                          DoubleTapped="OnRowDoubleTapped" KeyDown="OnRowKeyDown" AutomationProperties.Name="Calls" AutomationProperties.AutomationId="CallRows">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:CallRowItem">
                            <Grid ColumnSpacing="12" Padding="0,8" AutomationProperties.Name="{x:Bind Label, Mode=OneWay}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="36" Height="36">
                                    <Ellipse Fill="{ThemeResource BrandTintBlueBrush}" />
                                    <TextBlock Text="{x:Bind Initials, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontFamily="{StaticResource BrandHeadingFont}" FontWeight="SemiBold" Foreground="{ThemeResource BrandTintBlueInkBrush}" />
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" Foreground="{ThemeResource BrandOnBrush}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" MaxLines="1" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource BrandWarnBrush}" Visibility="{x:Bind Missed, Mode=OneWay}" />
                                        <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource BrandOn2Brush}" Visibility="{x:Bind views:CallsPage.Not(Missed), Mode=OneWay}" />
                                        <TextBlock Text="{x:Bind Detail, Mode=OneWay}" Style="{StaticResource BrandSecondary}" TextTrimming="CharacterEllipsis" MaxLines="1" TextWrapping="NoWrap" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                    <Button Style="{StaticResource RowAction}" Click="{x:Bind CallWhatsApp}" Visibility="{x:Bind HasWhatsAppVoice, Mode=OneWay}"
                                            AutomationProperties.Name="WhatsApp call" ToolTipService.ToolTip="WhatsApp call">
                                        <FontIcon Glyph="&#xE8BD;" FontSize="14" />
                                    </Button>
                                    <Button Style="{StaticResource RowAction}" Click="{x:Bind CallWhatsAppVideo}" Visibility="{x:Bind HasWhatsAppVideo, Mode=OneWay}"
                                            AutomationProperties.Name="WhatsApp video call" ToolTipService.ToolTip="WhatsApp video call">
                                        <FontIcon Glyph="&#xE714;" FontSize="14" />
                                    </Button>
                                    <Button Style="{StaticResource RowAction}" Click="{x:Bind Call}" Visibility="{x:Bind CanCall, Mode=OneWay}"
                                            Background="{ThemeResource BrandTintGreenBrush}" AutomationProperties.Name="Call" ToolTipService.ToolTip="Call (Enter)">
                                        <FontIcon Glyph="&#xE717;" FontSize="14" Foreground="{ThemeResource BrandTintGreenInkBrush}" />
                                    </Button>
                                </StackPanel>
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Call" Click="{x:Bind Call}" IsEnabled="{x:Bind CanCall, Mode=OneWay}" />
                                        <MenuFlyoutItem Text="Copy number" Click="OnCopyNumber" Tag="{x:Bind Number, Mode=OneWay}" IsEnabled="{x:Bind CanCall, Mode=OneWay}" />
                                        <MenuFlyoutItem Text="Open in WhatsApp on this PC" Click="OnWhatsAppHere" Tag="{x:Bind Number, Mode=OneWay}" IsEnabled="{x:Bind CanCall, Mode=OneWay}" />
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Visibility="{x:Bind views:CallsPage.Not(Calls.HasNotice), Mode=OneWay}">
                    <FontIcon Glyph="&#xE767;" FontSize="13" Foreground="{ThemeResource BrandOn2Brush}" />
                    <TextBlock Text="{x:Bind Calls.AudioText, Mode=OneWay}" Style="{StaticResource BrandSecondary}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
