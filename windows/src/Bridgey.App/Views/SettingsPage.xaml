<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Bridgey.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Bridgey.ViewModels">

    <UserControl.Resources>
        <Style x:Key="Row" TargetType="Border" BasedOn="{StaticResource BrandCard}">
            <Setter Property="Padding" Value="16,12" />
        </Style>
    </UserControl.Resources>

    <Grid Padding="24,20,32,24" ColumnSpacing="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ListView x:Name="SectionList" ItemsSource="{x:Bind Sections}" SelectionMode="Single" SelectionChanged="OnSectionChanged"
                  AutomationProperties.AutomationId="SettingsSections">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:SettingsSection">
                    <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,8" AutomationProperties.Name="{x:Bind Title}">
                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" />
                        <TextBlock Text="{x:Bind Title}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <ScrollViewer Grid.Column="1">
            <StackPanel x:Name="SectionPanel" Spacing="8" MaxWidth="680" HorizontalAlignment="Stretch" Padding="0,0,8,0">
                <TextBlock x:Name="SectionTitle" Style="{StaticResource BrandHeadline}" Margin="0,0,0,12" AutomationProperties.AutomationId="SettingsTitle" />

                <!-- This PC -->
                <StackPanel x:Name="ThisPc" Spacing="8" Tag="thisPc">
                    <Border Style="{StaticResource Row}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="260" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Name" Style="{StaticResource BrandBody}" />
                                <TextBlock Text="What your other devices call this PC." Style="{StaticResource BrandSecondary}" />
                            </StackPanel>
                            <TextBox x:Name="NameBox" Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind Settings.DeviceName, Mode=OneWay}" LostFocus="OnNameCommitted"
                                     KeyDown="OnNameKeyDown" AutomationProperties.AutomationId="DeviceName" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Allow pairing" Style="{StaticResource BrandBody}" />
                                <TextBlock Text="Lets a phone or Mac pair with this PC for two minutes." Style="{StaticResource BrandSecondary}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Allow" Click="OnAllowPairing" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Devices -->
                <StackPanel x:Name="DevicesSection" Spacing="8" Tag="devices">
                    <TextBlock Text="No paired devices yet." Style="{StaticResource BrandSecondary}" Visibility="{x:Bind Model.HasNoDevices, Mode=OneWay}" />
                    <ItemsRepeater ItemsSource="{x:Bind Model.Devices}" HorizontalAlignment="Stretch">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:DeviceItem">
                                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16,4,16,12"
                                          AutomationProperties.Name="{x:Bind Name, Mode=OneWay}" AutomationProperties.AutomationId="DeviceSettings">
                                    <Expander.Header>
                                        <Grid ColumnSpacing="16" Padding="0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="18" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Name, Mode=OneWay}" Style="{StaticResource BrandBody}" />
                                                <TextBlock Text="{x:Bind Status, Mode=OneWay}" Style="{StaticResource BrandSecondary}" />
                                            </StackPanel>
                                        </Grid>
                                    </Expander.Header>
                                    <StackPanel Spacing="2">
                                        <ItemsRepeater ItemsSource="{x:Bind Switches}">
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="vm:FeatureSwitch">
                                                    <Grid ColumnSpacing="16" Padding="0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource BrandBody}" VerticalAlignment="Center" />
                                                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind IsOn, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0"
                                                                      AutomationProperties.Name="{x:Bind Title}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                        <Button Content="Forget this device" Click="{x:Bind Forget}" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Expander>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

                <!-- Away from home -->
                <StackPanel x:Name="AwaySection" Spacing="8" Tag="away">
                    <Border Style="{StaticResource Row}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Connect away from home" Style="{StaticResource BrandBody}" />
                                <TextBlock Text="Your phone and Mac reach this PC on other networks, directly or through Round Robin's relay. Everything stays end-to-end encrypted." Style="{StaticResource BrandSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind Settings.ConnectAway, Mode=TwoWay}" AutomationProperties.Name="Connect away from home" AutomationProperties.AutomationId="ConnectAway" />
                        </Grid>
                    </Border>
                    <TextBlock Text="{x:Bind Model.ConnectStatus, Mode=OneWay}" Style="{StaticResource BrandSecondary}" TextWrapping="Wrap" Margin="4,0,0,0"
                               AutomationProperties.AutomationId="ConnectStatus" />
                </StackPanel>

                <!-- Clipboard -->
                <StackPanel x:Name="ClipboardSection" Spacing="8" Tag="clipboard">
                    <Border Style="{StaticResource Row}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Clipboard" Style="{StaticResource BrandBody}" />
                                <TextBlock Text="Send and receive text with paired devices. Each device can be turned off in Devices." Style="{StaticResource BrandSecondary}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind Settings.Clipboard, Mode=TwoWay}" AutomationProperties.Name="Clipboard" AutomationProperties.AutomationId="ClipboardOn" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Automatic clipboard" Style="{StaticResource BrandBody}" />
                                <TextBlock Text="Sends what you copy here to connected devices. Text a password manager marks as private is never sent." Style="{StaticResource BrandSecondary}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind Settings.AutomaticClipboard, Mode=TwoWay}" AutomationProperties.Name="Automatic clipboard" AutomationProperties.AutomationId="AutomaticClipboard" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Notifications -->
                <StackPanel x:Name="NotificationsSection" Spacing="8" Tag="notifications">
                    <Border Style="{StaticResource Row}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Notifications" Style="{StaticResource BrandBody}" />
                                <TextBlock Text="Show your phone's notifications on this PC. Each device can be turned off in Devices." Style="{StaticResource BrandSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind Settings.Notifications, Mode=TwoWay}" AutomationProperties.Name="Notifications" AutomationProperties.AutomationId="NotificationsOn" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Show as Windows notifications" Style="{StaticResource BrandBody}" />
                                <TextBlock Text="With the phone's own buttons, a reply box and Dismiss." Style="{StaticResource BrandSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind Settings.NotificationBanners, Mode=TwoWay}" AutomationProperties.Name="Show as Windows notifications" AutomationProperties.AutomationId="NotificationBanners" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Row}" Visibility="{x:Bind Notifications.HasApps, Mode=OneWay}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Show notifications from" Style="{StaticResource BrandBody}" />
                            <ItemsRepeater ItemsSource="{x:Bind Notifications.Apps}" AutomationProperties.AutomationId="NotificationApps">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AppFilterItem">
                                        <Grid ColumnSpacing="16" Padding="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" Style="{StaticResource BrandSecondary}" VerticalAlignment="Center" />
                                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind IsShown, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0"
                                                          AutomationProperties.Name="{x:Bind Name, Mode=OneWay}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Keep notification history" Style="{StaticResource BrandBody}" />
                                <TextBlock Text="The last 7 days, at most 200, encrypted on this PC. Codes are never kept." Style="{StaticResource BrandSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind Settings.NotificationHistory, Mode=TwoWay}" AutomationProperties.Name="Keep notification history" AutomationProperties.AutomationId="NotificationHistory" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Codes from messages" Style="{StaticResource BrandBody}" />
                                <TextBlock Text="Shows one-time codes from text messages with Copy code. They're found on this PC and never sent anywhere." Style="{StaticResource BrandSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind Settings.CodesFromMessages, Mode=TwoWay}" AutomationProperties.Name="Codes from messages" AutomationProperties.AutomationId="CodesFromMessages" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Also read codes in email" Style="{StaticResource BrandBody}" />
                                <TextBlock Text="Gmail, Outlook, Proton Mail and Spark." Style="{StaticResource BrandSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind Settings.CodesFromEmail, Mode=TwoWay}" AutomationProperties.Name="Also read codes in email" AutomationProperties.AutomationId="CodesFromEmail" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Copy codes automatically" Style="{StaticResource BrandBody}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind Settings.CopyCodes, Mode=TwoWay}" AutomationProperties.Name="Copy codes automatically" AutomationProperties.AutomationId="CopyCodes" />
                        </Grid>
                    </Border>
                    <ItemsRepeater ItemsSource="{x:Bind Notifications.CodesDevices}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:CodesDevice">
                                <Border Style="{StaticResource BrandCard}" Padding="16,12">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Text, Mode=OneWay}" Style="{StaticResource BrandSecondary}" TextWrapping="Wrap" VerticalAlignment="Center"
                                                   AutomationProperties.AutomationId="CodesStatus" />
                                        <Button Grid.Column="1" Content="Link" Click="{x:Bind Link}" Visibility="{x:Bind NeedsLink, Mode=OneWay}" VerticalAlignment="Center"
                                                AutomationProperties.AutomationId="LinkPhone" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                    <Border Style="{StaticResource Row}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Share when I'm using this PC" Style="{StaticResource BrandBody}" />
                                <TextBlock Text="Your phone sends its alerts to the device you're using. Only whether there was recent input is shared." Style="{StaticResource BrandSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind Settings.ShareActivity, Mode=TwoWay}" AutomationProperties.Name="Share when I'm using this PC" AutomationProperties.AutomationId="ShareActivity" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Files -->
                <StackPanel x:Name="FilesSection" Spacing="8" Tag="files">
                    <Border Style="{StaticResource Row}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Files" Style="{StaticResource BrandBody}" />
                                <TextBlock Text="Send and receive files with paired devices. Each device can be turned off in Devices." Style="{StaticResource BrandSecondary}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind Settings.Files, Mode=TwoWay}" AutomationProperties.Name="Files" AutomationProperties.AutomationId="FilesOn" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <Grid ColumnSpacing="16" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Save received files in" Style="{StaticResource BrandBody}" />
                                <TextBlock Text="{x:Bind Settings.ReceiveFolder, Mode=OneWay}" Style="{StaticResource BrandSecondary}" TextTrimming="CharacterEllipsis"
                                           IsTextSelectionEnabled="True" AutomationProperties.AutomationId="ReceiveFolder" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Content="Open" Click="OnOpenReceiveFolder" AutomationProperties.AutomationId="OpenReceiveFolder" />
                                <Button Content="Change" Click="OnChangeReceiveFolder" AutomationProperties.AutomationId="ChangeReceiveFolder" />
                                <Button Content="Use Downloads" Click="OnResetReceiveFolder" Visibility="{x:Bind Settings.ReceiveFolderIsCustom, Mode=OneWay}" AutomationProperties.AutomationId="ResetReceiveFolder" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Notify when a file arrives" Style="{StaticResource BrandBody}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind Settings.FileNotifications, Mode=TwoWay}" AutomationProperties.Name="Notify when a file arrives" AutomationProperties.AutomationId="FileNotifications" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Show Bridgey in Send to" Style="{StaticResource BrandBody}" />
                                <TextBlock Text="Right-click files in Explorer, then Send to, then Bridgey." Style="{StaticResource BrandSecondary}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind Settings.SendToMenu, Mode=TwoWay}" AutomationProperties.Name="Show Bridgey in Send to" AutomationProperties.AutomationId="SendToMenu" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Media and actions -->
                <!-- Text messages -->
                <StackPanel x:Name="MessagesSection" Spacing="8" Tag="messages">
                    <Border Style="{StaticResource Row}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Text messages" Style="{StaticResource BrandBody}" />
                                <TextBlock Text="Read and send your phone's texts on this PC. Turn it on for this PC in Bridgey on the phone too." Style="{StaticResource BrandSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind Settings.TextMessages, Mode=TwoWay}" AutomationProperties.Name="Text messages" AutomationProperties.AutomationId="TextMessagesOn" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Keep conversations on this PC" Style="{StaticResource BrandBody}" />
                                <TextBlock Text="Up to 200 conversations, encrypted for your Windows account. Off keeps them only while Bridgey runs." Style="{StaticResource BrandSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind Settings.KeepConversations, Mode=TwoWay}" IsEnabled="{x:Bind Settings.TextMessages, Mode=OneWay}"
                                          AutomationProperties.Name="Keep conversations on this PC" AutomationProperties.AutomationId="KeepConversations" />
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="MediaSection" Spacing="8" Tag="media">
                    <Border Style="{StaticResource Row}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Links" Style="{StaticResource BrandBody}" />
                                <TextBlock Text="Send links to your phone and open the ones it sends." Style="{StaticResource BrandSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind Settings.Links, Mode=TwoWay}" AutomationProperties.Name="Links" AutomationProperties.AutomationId="LinksOn" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Open links right away" Style="{StaticResource BrandBody}" />
                                <TextBlock Text="A link your phone sends with Open on PC opens in your browser at once. Otherwise it waits on Home." Style="{StaticResource BrandSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind Settings.OpenLinksRightAway, Mode=TwoWay}" AutomationProperties.Name="Open links right away" AutomationProperties.AutomationId="OpenLinksRightAway" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Browser extensions" Style="{StaticResource BrandBody}" />
                                <TextBlock Text="{x:Bind Settings.BrowserSupportStatus, Mode=OneWay}" Style="{StaticResource BrandSecondary}" TextWrapping="Wrap" AutomationProperties.AutomationId="BrowserSupportStatus" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind Settings.BrowserSupport, Mode=TwoWay}" AutomationProperties.Name="Browser extensions" AutomationProperties.AutomationId="BrowserSupport" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Media controls" Style="{StaticResource BrandBody}" />
                                <TextBlock Text="Your phone can play, pause, skip and seek what's playing on this PC, and shows what it is." Style="{StaticResource BrandSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind Settings.Media, Mode=TwoWay}" AutomationProperties.Name="Media controls" AutomationProperties.AutomationId="MediaOn" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Battery" Style="{StaticResource BrandBody}" />
                                <TextBlock Text="Show this PC's battery on your other devices, and theirs here." Style="{StaticResource BrandSecondary}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind Settings.Battery, Mode=TwoWay}" AutomationProperties.Name="Battery" AutomationProperties.AutomationId="BatteryOn" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Find device" Style="{StaticResource BrandBody}" />
                                <TextBlock Text="Your other devices can ring this PC until you stop it, and it can ring them." Style="{StaticResource BrandSecondary}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind Settings.FindDevice, Mode=TwoWay}" AutomationProperties.Name="Find device" AutomationProperties.AutomationId="FindDeviceOn" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Ping" Style="{StaticResource BrandBody}" />
                                <TextBlock Text="One short sound when a paired device pings this PC." Style="{StaticResource BrandSecondary}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind Settings.Ping, Mode=TwoWay}" AutomationProperties.Name="Ping" AutomationProperties.AutomationId="PingOn" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Privacy -->
                <StackPanel x:Name="PrivacySection" Spacing="8" Tag="privacy">
                    <Border Style="{StaticResource Row}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Show previews in activity" Style="{StaticResource BrandBody}" />
                                <TextBlock Text="Activity stays on this PC and is cleared when Bridgey quits." Style="{StaticResource BrandSecondary}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind Settings.ShowPreviews, Mode=TwoWay}" AutomationProperties.Name="Show previews in activity" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Updates -->
                <StackPanel x:Name="UpdatesSection" Spacing="8" Tag="updates">
                    <Border Style="{StaticResource Row}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Channel" Style="{StaticResource BrandBody}" />
                                <TextBlock Text="Beta and Nightly get new features first." Style="{StaticResource BrandSecondary}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" SelectedIndex="{x:Bind Updates.ChannelIndex, Mode=TwoWay}" MinWidth="170" VerticalAlignment="Center"
                                      AutomationProperties.Name="Channel" AutomationProperties.AutomationId="UpdateChannel">
                                <ComboBoxItem Content="Stable" />
                                <ComboBoxItem Content="Beta" />
                                <ComboBoxItem Content="Nightly" />
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Check for updates when Bridgey opens" Style="{StaticResource BrandBody}" />
                                <TextBlock Text="At most every six hours. You choose when to install." Style="{StaticResource BrandSecondary}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind Updates.AutoCheck, Mode=TwoWay}" AutomationProperties.Name="Check for updates when Bridgey opens"
                                          AutomationProperties.AutomationId="AutoUpdateCheck" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <Grid ColumnSpacing="16" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Settings.ShortVersion}" Style="{StaticResource BrandBody}" />
                                <TextBlock Text="{x:Bind Updates.Status, Mode=OneWay}" Style="{StaticResource BrandSecondary}" TextWrapping="Wrap"
                                           AutomationProperties.AutomationId="UpdateStatus" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Content="Check now" Click="OnCheckUpdates" IsEnabled="{x:Bind Updates.CanCheck, Mode=OneWay}" AutomationProperties.AutomationId="CheckUpdates" />
                                <Button Content="Install" Style="{StaticResource AccentButtonStyle}" Click="OnInstallUpdate" Visibility="{x:Bind Updates.HasOffer, Mode=OneWay}"
                                        IsEnabled="{x:Bind Updates.CanInstall, Mode=OneWay}" AutomationProperties.AutomationId="InstallUpdate" />
                            </StackPanel>
                            <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Value="{x:Bind Updates.Progress, Mode=OneWay}" Maximum="100"
                                         Visibility="{x:Bind Updates.IsBusy, Mode=OneWay}" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- General -->
                <StackPanel x:Name="GeneralSection" Spacing="8" Tag="general">
                    <Border Style="{StaticResource Row}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Appearance" Style="{StaticResource BrandBody}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" SelectedIndex="{x:Bind Settings.ThemeIndex, Mode=TwoWay}" MinWidth="170" VerticalAlignment="Center"
                                      AutomationProperties.Name="Appearance" AutomationProperties.AutomationId="Appearance">
                                <ComboBoxItem Content="Same as Windows" />
                                <ComboBoxItem Content="Light" />
                                <ComboBoxItem Content="Dark" />
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Reduce motion" Style="{StaticResource BrandBody}" />
                                <TextBlock Text="Windows' own Animation effects setting always applies." Style="{StaticResource BrandSecondary}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind Settings.ReduceMotion, Mode=TwoWay}" AutomationProperties.Name="Reduce motion" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Start Bridgey when you sign in" Style="{StaticResource BrandBody}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind Settings.StartAtSignIn, Mode=TwoWay}" AutomationProperties.Name="Start Bridgey when you sign in" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Keep running in the notification area" Style="{StaticResource BrandBody}" />
                                <TextBlock Text="Closing the window keeps devices connected. Quit from the Bridgey icon's menu." Style="{StaticResource BrandSecondary}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind Settings.KeepRunningInTray, Mode=TwoWay}" AutomationProperties.Name="Keep running in the notification area" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- About -->
                <StackPanel x:Name="AboutSection" Spacing="12" Tag="about">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <Image Source="ms-appx:///Assets/AppMark256.png" Width="64" Height="64" />
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{x:Bind Settings.AppName}" Style="{StaticResource BrandSectionTitle}" />
                            <TextBlock Text="{x:Bind Settings.ShortVersion}" Style="{StaticResource BrandBody}" AutomationProperties.AutomationId="ShortVersion" />
                            <TextBlock Text="{x:Bind Settings.FullVersion}" Style="{StaticResource BrandSecondary}" IsTextSelectionEnabled="True" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="{x:Bind Settings.UpstreamCredit}" Style="{StaticResource BrandBody}" />
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <HyperlinkButton Content="Bridgey by Semyon Mikhailov" NavigateUri="{x:Bind UpstreamUri}" />
                        <HyperlinkButton Content="This edition" NavigateUri="{x:Bind EditionUri}" />
                    </StackPanel>
                </StackPanel>

                <!-- Sections that have not reached Windows yet -->
                <TextBlock x:Name="LaterSection" Text="This comes to Windows in a later beta. The phone and Mac apps already have it."
                           Style="{StaticResource BrandSecondary}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
