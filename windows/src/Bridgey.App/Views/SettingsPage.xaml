<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Bridgey.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Bridgey.ViewModels">

    <UserControl.Resources>
        <Style x:Key="Row" TargetType="Border" BasedOn="{StaticResource BrandCard}">
            <Setter Property="Padding" Value="16,12" />
        </Style>
    </UserControl.Resources>

    <Grid Padding="24,20,32,24" ColumnSpacing="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ListView x:Name="SectionList" ItemsSource="{x:Bind Sections}" SelectionMode="Single" SelectionChanged="OnSectionChanged"
                  AutomationProperties.AutomationId="SettingsSections">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:SettingsSection">
                    <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,8" AutomationProperties.Name="{x:Bind Title}">
                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" />
                        <TextBlock Text="{x:Bind Title}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <ScrollViewer Grid.Column="1">
            <StackPanel x:Name="SectionPanel" Spacing="8" MaxWidth="680" HorizontalAlignment="Left" Padding="0,0,8,0">
                <TextBlock x:Name="SectionTitle" Style="{StaticResource BrandHeadline}" Margin="0,0,0,12" AutomationProperties.AutomationId="SettingsTitle" />

                <!-- This PC -->
                <StackPanel x:Name="ThisPc" Spacing="8" Tag="thisPc">
                    <Border Style="{StaticResource Row}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="260" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Name" Style="{StaticResource BrandBody}" />
                                <TextBlock Text="What your other devices call this PC." Style="{StaticResource BrandSecondary}" />
                            </StackPanel>
                            <TextBox x:Name="NameBox" Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind Settings.DeviceName, Mode=OneWay}" LostFocus="OnNameCommitted"
                                     KeyDown="OnNameKeyDown" AutomationProperties.AutomationId="DeviceName" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Allow pairing" Style="{StaticResource BrandBody}" />
                                <TextBlock Text="Lets a phone or Mac pair with this PC for two minutes." Style="{StaticResource BrandSecondary}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Allow" Click="OnAllowPairing" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Devices -->
                <StackPanel x:Name="DevicesSection" Spacing="8" Tag="devices">
                    <TextBlock Text="No paired devices yet." Style="{StaticResource BrandSecondary}" Visibility="{x:Bind Model.HasNoDevices, Mode=OneWay}" />
                    <ItemsRepeater ItemsSource="{x:Bind Model.Devices}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:DeviceItem">
                                <Border Style="{StaticResource BrandCard}" Padding="16,12">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="18" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" Style="{StaticResource BrandBody}" />
                                            <TextBlock Text="{x:Bind Status, Mode=OneWay}" Style="{StaticResource BrandSecondary}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="2" OnContent="Clipboard on" OffContent="Clipboard off" VerticalAlignment="Center"
                                                      IsOn="{x:Bind ClipboardAllowed, Mode=TwoWay}" AutomationProperties.Name="Clipboard" />
                                        <Button Grid.Column="3" Content="Forget" Click="{x:Bind Forget}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

                <!-- Clipboard -->
                <StackPanel x:Name="ClipboardSection" Spacing="8" Tag="clipboard">
                    <Border Style="{StaticResource Row}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Clipboard" Style="{StaticResource BrandBody}" />
                                <TextBlock Text="Send and receive text with paired devices. Each device can be turned off in Devices." Style="{StaticResource BrandSecondary}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind Settings.Clipboard, Mode=TwoWay}" AutomationProperties.Name="Clipboard" AutomationProperties.AutomationId="ClipboardOn" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Automatic clipboard" Style="{StaticResource BrandBody}" />
                                <TextBlock Text="Sends what you copy here to connected devices. Text a password manager marks as private is never sent." Style="{StaticResource BrandSecondary}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind Settings.AutomaticClipboard, Mode=TwoWay}" AutomationProperties.Name="Automatic clipboard" AutomationProperties.AutomationId="AutomaticClipboard" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Privacy -->
                <StackPanel x:Name="PrivacySection" Spacing="8" Tag="privacy">
                    <Border Style="{StaticResource Row}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Show previews in activity" Style="{StaticResource BrandBody}" />
                                <TextBlock Text="Activity stays on this PC and is cleared when Bridgey quits." Style="{StaticResource BrandSecondary}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind Settings.ShowPreviews, Mode=TwoWay}" AutomationProperties.Name="Show previews in activity" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- General -->
                <StackPanel x:Name="GeneralSection" Spacing="8" Tag="general">
                    <Border Style="{StaticResource Row}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Appearance" Style="{StaticResource BrandBody}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" SelectedIndex="{x:Bind Settings.ThemeIndex, Mode=TwoWay}" MinWidth="170" VerticalAlignment="Center"
                                      AutomationProperties.Name="Appearance" AutomationProperties.AutomationId="Appearance">
                                <ComboBoxItem Content="Same as Windows" />
                                <ComboBoxItem Content="Light" />
                                <ComboBoxItem Content="Dark" />
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Reduce motion" Style="{StaticResource BrandBody}" />
                                <TextBlock Text="Windows' own Animation effects setting always applies." Style="{StaticResource BrandSecondary}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind Settings.ReduceMotion, Mode=TwoWay}" AutomationProperties.Name="Reduce motion" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Start Bridgey when you sign in" Style="{StaticResource BrandBody}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind Settings.StartAtSignIn, Mode=TwoWay}" AutomationProperties.Name="Start Bridgey when you sign in" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Keep running in the notification area" Style="{StaticResource BrandBody}" />
                                <TextBlock Text="Closing the window keeps devices connected. Quit from the Bridgey icon's menu." Style="{StaticResource BrandSecondary}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind Settings.KeepRunningInTray, Mode=TwoWay}" AutomationProperties.Name="Keep running in the notification area" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- About -->
                <StackPanel x:Name="AboutSection" Spacing="12" Tag="about">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <Image Source="ms-appx:///Assets/AppMark256.png" Width="64" Height="64" />
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{x:Bind Settings.AppName}" Style="{StaticResource BrandSectionTitle}" />
                            <TextBlock Text="{x:Bind Settings.ShortVersion}" Style="{StaticResource BrandBody}" AutomationProperties.AutomationId="ShortVersion" />
                            <TextBlock Text="{x:Bind Settings.FullVersion}" Style="{StaticResource BrandSecondary}" IsTextSelectionEnabled="True" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="{x:Bind Settings.UpstreamCredit}" Style="{StaticResource BrandBody}" />
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <HyperlinkButton Content="Bridgey by Semyon Mikhailov" NavigateUri="{x:Bind UpstreamUri}" />
                        <HyperlinkButton Content="This edition" NavigateUri="{x:Bind EditionUri}" />
                    </StackPanel>
                </StackPanel>

                <!-- Sections that have not reached Windows yet -->
                <TextBlock x:Name="LaterSection" Text="This comes to Windows in a later beta. The phone and Mac apps already have it."
                           Style="{StaticResource BrandSecondary}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
