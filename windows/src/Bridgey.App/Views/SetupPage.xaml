<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Bridgey.Views.SetupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Border Style="{StaticResource BrandCard}" Padding="36,32" MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center"
                AutomationProperties.AutomationId="Setup">
            <StackPanel Spacing="20">
                <Image Source="ms-appx:///Assets/AppMark256.png" Width="72" Height="72" HorizontalAlignment="Left" />
                <StackPanel Spacing="6">
                    <TextBlock Text="Welcome to Bridgey" Style="{StaticResource BrandHeadline}" />
                    <TextBlock Text="Copy on this PC, paste on your phone or Mac, and back again." Style="{StaticResource BrandSecondary}" FontSize="14" />
                </StackPanel>
                <TextBox x:Name="NameBox" Header="Name this PC" Text="{x:Bind Settings.DeviceName, Mode=OneTime}"
                         AutomationProperties.AutomationId="SetupName" />
                <ToggleSwitch Header="Start Bridgey when you sign in" IsOn="{x:Bind Settings.StartAtSignIn, Mode=TwoWay}" />
                <Button Content="Continue" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" Click="OnContinue"
                        AutomationProperties.AutomationId="SetupContinue" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
