<Project Sdk="Microsoft.NET.Sdk">
  <!-- Bridgey by Round Robin for Windows: WinUI 3 (Windows App SDK), C# compiled ahead of time (NativeAOT),
       unpackaged and self-contained for x64 and Arm64. The session runs in bridgey_core.dll (rust/client). -->
  <PropertyGroup>
    <!-- Warnings stay warnings here until the first Windows builds show which generator warnings remain. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>Bridgey</RootNamespace>
    <AssemblyName>Bridgey</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Bridgey.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Program.cs starts the app, after the single-instance check. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- File version: the edition's next version; the full name and build number are in Edition.g.cs. -->
    <Version>$(EditionNextVersion)</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bridgey.Core\Bridgey.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- bridgey_core.dll for the architecture being built; scripts/rr/build-windows.ps1 passes BridgeyNativeDir. -->
    <None Include="$(BridgeyNativeDir)\bridgey_core.dll" Condition="'$(BridgeyNativeDir)' != ''" Link="bridgey_core.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
</Project>
