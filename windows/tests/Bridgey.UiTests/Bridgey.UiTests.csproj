<Project Sdk="Microsoft.NET.Sdk">
  <!-- UI automation on a Windows desktop (the RR CI windows lane): launches the published app, takes light and dark
       screenshots and pairs with the scripted Rust peer (rust/client/examples/peer.rs). Windows only. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Warnings stay warnings here until the first Windows builds show which generator warnings remain. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>Bridgey.UiTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.3" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.3" />
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
  </ItemGroup>
</Project>
